// Ghana Digital Twin — World Model Foundation schema
// Spatial storage on PostgreSQL (Neon): geometry stored as GeoJSON + dedicated
// bbox/centroid columns for indexed spatial queries. Turf provides precise geometry ops.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Core Entity (versioned, provenance-tracked) =====
model Entity {
  id              String   @id @default(uuid())
  uuid            String   @unique
  // stable external identifier (e.g. "geoboundaries:GHA-ADM1-ashanti", "osm:way:4790617")
  externalId      String   @unique
  kind            String   // river | lake | watershed | forest | road | settlement | ...
  type            String   // natural | infrastructure | administrative | human_activity
  name            String
  regionId        String?
  geometryType    String   // Point | LineString | Polygon | MultiPolygon
  geometryGeoJson String   // full GeoJSON geometry (WGS84)
  // spatial index columns
  centroidLng     Float
  centroidLat     Float
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  areaKm2         Float?
  lengthKm        Float?
  attributes      String   @default("{}") // JSON
  tags            String   @default("[]") // JSON array
  confidence      Float    @default(1.0)
  // provenance
  datasetSourceId String
  sourceName      String
  sourceVersion   String
  // temporal
  firstObserved   DateTime
  lastObserved    DateTime
  currentVersion  Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  datasetSource     DatasetSource  @relation(fields: [datasetSourceId], references: [id])
  versions          EntityVersion[]
  relationshipsFrom Relationship[] @relation("fromEntity")
  relationshipsTo   Relationship[] @relation("toEntity")

  @@index([kind])
  @@index([type])
  @@index([regionId])
  @@index([minLng, maxLng, minLat, maxLat])
  @@index([centroidLng, centroidLat])
}

// ===== Versioned history (nothing is overwritten) =====
model EntityVersion {
  id              String   @id @default(uuid())
  entityId        String
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  version         Int
  change          String   // human description of what changed
  geometryGeoJson String
  attributes      String
  confidence      Float
  sourceName      String
  sourceVersion   String
  observedAt      DateTime
  createdAt       DateTime @default(now())

  @@unique([entityId, version])
  @@index([entityId, version])
  @@index([observedAt])
}

// ===== Spatial relationship graph =====
model Relationship {
  id           String   @id @default(uuid())
  fromEntityId String
  toEntityId   String
  relation     String   // contains | within | intersects | adjacent_to | tributary_of | flows_to | part_of | near
  inferredBy   String   // spatial | source | manual
  confidence   Float    @default(1.0)
  createdAt    DateTime @default(now())

  fromEntity Entity @relation("fromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   Entity @relation("toEntity", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relation])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relation])
}

// ===== Dataset source registry (provenance + health) =====
model DatasetSource {
  id            String    @id @default(uuid())
  sourceId      String    @unique // "geoboundaries", "osm-overpass", "hydrosheds", ...
  name          String
  category      String    // administrative | hydrology | dem | landcover | weather | infrastructure | environmental | population | forest
  provider      String
  license       String
  resolution    String
  cadence       String
  coverage      String
  description   String
  storageType   String    @default("vector") // vector | raster | metadata
  status        String    @default("pending") // pending | healthy | syncing | degraded | offline
  recordCount   Int       @default(0)
  version       String?
  lastSyncAt    DateTime?
  lastSuccessAt DateTime?
  metadata      String    @default("{}") // JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entities Entity[]
  runs     ConnectorRun[]


  @@index([status])
}

// ===== Connector run history (observability) =====
model ConnectorRun {
  id             String   @id @default(uuid())
  sourceId       String
  source         DatasetSource @relation(fields: [sourceId], references: [id])
  startedAt      DateTime
  finishedAt     DateTime?
  status         String   // running | success | failed | partial
  stage          String   @default("") // current pipeline stage
  recordsRead    Int      @default(0)
  recordsWritten Int     @default(0)
  durationMs     Int      @default(0)
  error          String?
  events         String   @default("[]") // JSON array of pipeline stage events
  createdAt      DateTime @default(now())

  @@index([sourceId, startedAt])
  @@index([status])
}

// ===== Event log (powers downstream AI + observability) =====
model IngestionEvent {
  id        String   @id @default(uuid())
  type      String   // DatasetDownloaded | DatasetValidated | EntityCreated | EntityUpdated | EntityVersionCreated | RelationshipsUpdated | ConnectorFailed | ConnectorRecovered | ...
  sourceId  String?
  entityId  String?
  message   String
  level     String   @default("info") // info | warn | error
  payload   String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([type])
  @@index([sourceId])
  @@index([createdAt])
}

// ===== Earth Observation Platform (Milestone 2.5) =====

// STAC item — one satellite scene
model RasterScene {
  id              String   @id @default(uuid())
  stacId          String   @unique // e.g. "S2B_30NYM_20240701_0_L2A"
  collection      String   // "sentinel-2-l2a" | "sentinel-2-c1-l2a" | "landsat-c2-l2" | ...
  platform        String?  // "Sentinel-2B"
  instrument      String?  // "MSI"
  constellation   String?  // "sentinel-2"
  // spatial
  geometryGeoJson String   // footprint GeoJSON
  centroidLng     Float
  centroidLat     Float
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  mgrsTile        String?  // "30NYM"
  // temporal
  datetime        DateTime
  // quality
  cloudCover      Float?
  // processing
  processingLevel String?  // "L2A"
  gsd             Float?   // ground sample distance (m)
  // provenance
  sourceId        String   // dataset source id ("stac-sentinel-2")
  stacVersion     String   @default("1.0.0")
  selfHref        String?
  metadata        String   @default("{}") // JSON (extra STAC properties)
  createdAt       DateTime @default(now())

  bands         RasterBand[]
  indexLayers   SpectralIndexLayer[]

  @@index([collection, datetime])
  @@index([centroidLng, centroidLat])
  @@index([minLng, maxLng, minLat, maxLat])
  @@index([datetime])
  @@index([mgrsTile])
  @@index([cloudCover])
}

// One band of a scene (e.g. red, nir, green, blue, swir16, scl) — references real COG URL
model RasterBand {
  id           String   @id @default(uuid())
  sceneId      String
  scene        RasterScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  name         String   // "red" | "nir" | "green" | "blue" | "swir16" | "scl" | ...
  commonName   String?  // "red" | "nir" ...
  displayName  String?  // "Red (B04)"
  href         String   // real COG URL on S3 / elsewhere
  type         String?  // "image/tiff; application=geotiff; profile=cloud-optimized"
  roles        String   @default("[]") // JSON array
  gsd          Float?
  shapeW       Int?
  shapeH       Int?
  // band metadata (wavelength etc.)
  bandMetadata String   @default("{}") // JSON
  createdAt    DateTime @default(now())

  @@unique([sceneId, name])
  @@index([sceneId])
  @@index([name])
}

// Computed spectral index layer (NDVI, NDWI, NBR, EVI, BSI, MNDWI, SAVI)
// References the source scene + the index formula; values computed on demand
// from real band pixels and cached as statistics.
model SpectralIndexLayer {
  id           String   @id @default(uuid())
  sceneId      String
  scene        RasterScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  indexName    String   // "NDVI" | "NDWI" | "NBR" | "EVI" | "BSI" | "MNDWI" | "SAVI"
  formula      String   // human-readable formula
  // cached statistics (computed once from real pixels over the scene footprint)
  meanValue    Float?
  minValue     Float?
  maxValue     Float?
  stdValue     Float?
  validPixelPct Float?
  computedAt   DateTime?
  createdAt    DateTime @default(now())

  @@unique([sceneId, indexName])
  @@index([sceneId])
  @@index([indexName])
}

// Factual Earth-Observation Observation (NOT AI — just facts, no conclusions)
// e.g. "NDVI decreased from 0.62 to 0.41 at [lng,lat] between [date1] and [date2]"
model EOObservation {
  id            String   @id @default(uuid())
  type          String   // "index_change" | "scene_acquired" | "cloud_gap" | "landcover_shift"
  indexName     String?  // "NDVI" | "NDWI" | ... (if applicable)
  locationLng   Float
  locationLat   Float
  // the two scenes compared
  beforeSceneId String?
  afterSceneId  String?
  // the measured values (objective facts)
  beforeValue   Float?
  afterValue    Float?
  deltaValue    Float?
  deltaPct      Float?
  // timing
  beforeDate    DateTime?
  afterDate     DateTime
  // affected world-model entity (if located)
  entityId      String?
  // objective description (NO conclusions about legality)
  summary       String
  confidence    Float    @default(1.0)
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([indexName])
  @@index([entityId])
  @@index([afterDate])
  @@index([locationLng, locationLat])
}

// ===== Milestone 2.75: Raster Intelligence Platform =====

// Seasonal baseline: expected condition (mean + std) per MGRS tile + season + index
model SeasonalBaseline {
  id            String   @id @default(uuid())
  indexName     String   // "NDVI" | "NDWI" | "NBR" | "BSI" | "MNDWI" | "EVI" | "SAVI"
  mgrsTile      String   // "30NYM"
  season        String   // "2026-Q3" or month "04"
  // gridded baseline (flattened gridSize × gridSize arrays)
  gridSize      Int      // e.g. 50
  meanGrid      String   // JSON float[] — per-cell expected mean
  stdGrid       String   // JSON float[] — per-cell expected std
  sampleCount   Int      // number of scenes used to build baseline
  uncertainty   Float    // mean per-cell uncertainty (propagated)
  // spatial extent
  minLng        Float
  minLat        Float
  maxLng        Float
  maxLat        Float
  computedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([indexName, mgrsTile, season])
  @@index([mgrsTile, season])
  @@index([indexName])
}

// Raster intelligence product: derived gridded layer with uncertainty
model RasterProduct {
  id             String   @id @default(uuid())
  type           String   // vegetation_anomaly | water_anomaly | burn_severity | bare_soil | moisture_anomaly | temporal_variance | cloud_free_composite | change_probability
  indexName      String?  // source index (NDVI, NDWI, etc.)
  sceneId        String?  // scene this product is derived from (if applicable)
  baselineId     String?  // baseline used for comparison (if applicable)
  mgrsTile       String?  // MGRS tile this covers
  season         String?  // season label
  // gridded data
  gridSize       Int      // e.g. 50
  valueGrid      String   // JSON float[] — per-cell product value
  uncertaintyGrid String  // JSON float[] — per-cell uncertainty (±)
  // summary stats
  meanValue      Float?
  minValue       Float?
  maxValue       Float?
  stdValue       Float?
  // provenance
  formula        String   // human-readable how it was computed
  sources        String   @default("[]") // JSON array of source dataset names
  confidence     Float    @default(1.0)
  // spatial extent
  minLng         Float
  minLat         Float
  maxLng         Float
  maxLat         Float
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([type])
  @@index([mgrsTile])
  @@index([sceneId])
  @@index([indexName])
}

// ===== Milestone 3: Observation Engine =====
// Observations are first-class, immutable, versioned objects. Each is produced
// by EVIDENCE FUSION across multiple raster products — never a single source.
// Observations describe objective physical-world change. No legal conclusions.

model Observation {
  id              String   @id @default(uuid())
  uuid            String   @unique
  type            String   // surface_disturbance | water_body_change | vegetation_loss | burn_event | moisture_stress
  title           String
  summary         String   // objective description, no legal conclusions
  // spatial
  geometryGeoJson String   // polygon or point
  centroidLng     Float
  centroidLat     Float
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  areaHa          Float    // affected area in hectares
  // temporal
  observedAt      DateTime
  firstObserved   DateTime
  lastUpdated     DateTime
  durationDays    Float?   // how long the change has persisted
  // assessment (fused)
  confidence      Float    // 0..1, fused from all evidence
  uncertainty     Float    // ± propagated uncertainty
  status          String   @default("active") // candidate | active | monitoring | resolved
  severity        String   @default("moderate") // low | moderate | high | critical
  // versioning (immutable — new version on evidence change)
  currentVersion  Int      @default(1)
  // provenance
  sourceProducts  String   @default("[]") // JSON: product IDs that contributed evidence
  sourceModels    String   @default("[]") // JSON: model versions used
  mgrsTile        String?
  sceneId         String?  // primary scene
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence        ObservationEvidence[]
  versions        ObservationVersion[]
  affectedEntities ObservationEntityLink[]
  evidenceLinks   ObservationEvidenceLink[]
  phenomena       PhenomenonObservation[]
  bundles         EvidenceBundle[]
  hypotheses      Hypothesis[]
  scenarios       Scenario[]

  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([centroidLng, centroidLat])
  @@index([minLng, maxLng, minLat, maxLat])
  @@index([observedAt])
  @@index([mgrsTile])
}

// Per-evidence breakdown — each raster product that contributed to the fused observation
model ObservationEvidence {
  id              String   @id @default(uuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  productType     String   // vegetation_anomaly | water_anomaly | bare_soil | change_probability | ...
  productId       String?  // FK to RasterProduct
  indexName       String?  // source spectral index
  value           Float    // the product value at this location
  normalizedSignal Float   // 0..1 normalized contribution
  weight          Float    // fusion weight
  confidence      Float    // per-evidence confidence
  uncertainty     Float    // per-evidence uncertainty
  contribution    Float    // actual contribution to fused signal (weight × signal)
  description     String   // human-readable evidence description
  createdAt       DateTime @default(now())

  @@index([observationId])
  @@index([productType])
}

// Immutable version history — nothing is overwritten
model ObservationVersion {
  id              String   @id @default(uuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  version         Int
  change          String   // what changed in this version
  confidence      Float
  uncertainty     Float
  status          String
  evidenceCount   Int
  observedAt      DateTime
  createdAt       DateTime @default(now())

  @@unique([observationId, version])
  @@index([observationId, version])
}

// Link observations to affected world-model entities (rivers, forests, settlements...)
model ObservationEntityLink {
  id              String   @id @default(uuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  entityId        String   // FK to Entity
  relationship    String   // overlaps | adjacent_to | within | upstream | downstream
  distance        Float?   // distance in km (if not overlapping)
  createdAt       DateTime @default(now())

  @@unique([observationId, entityId])
  @@index([observationId])
  @@index([entityId])
}

// ===== Milestone 3.5: Temporal Intelligence Engine =====
// Evidence as first-class immutable objects (reusable across observations),
// evolving Phenomena (temporal merging), Observation Lineage, and an
// Environmental Knowledge Graph (domain concepts separate from World Model).

// ---- Standalone Evidence (immutable, reusable) ----
// Evidence can support multiple observations. Not embedded in observations.
model Evidence {
  id              String   @id @default(uuid())
  uuid            String   @unique
  // what kind of evidence
  productType     String   // vegetation_anomaly | water_anomaly | bare_soil | change_probability | ...
  indexName       String?  // NDVI | NDWI | NBR | ...
  // the source raster product (lineage link)
  productId       String?  // FK to RasterProduct
  // spatial
  geometryGeoJson String   // point or polygon where evidence was measured
  centroidLng     Float
  centroidLat     Float
  // temporal
  observedAt      DateTime // when the source scene was captured
  // measurement
  value           Float    // the product value at this location
  normalizedSignal Float   // 0..1 normalized anomaly signal
  confidence      Float    // per-evidence confidence
  uncertainty     Float    // per-evidence uncertainty (±)
  direction       String   @default("neutral") // loss | gain | neutral
  description     String   // human-readable
  // supporting lineage (drill-down chain)
  supportingPixels Int     @default(0) // how many pixels contributed
  supportingSceneId String? // FK to RasterScene
  supportingBandHrefs String @default("[]") // JSON: COG band URLs used
  createdAt       DateTime @default(now())

  observationLinks ObservationEvidenceLink[]

  @@index([productType])
  @@index([centroidLng, centroidLat])
  @@index([observedAt])
  @@index([productId])
}

// Many-to-many: observations reference standalone evidence objects
model ObservationEvidenceLink {
  id              String   @id @default(uuid())
  observationId   String
  evidenceId      String
  weight          Float    // fusion weight of this evidence for this observation
  contribution    Float    // actual contribution (weight × signal)
  createdAt       DateTime @default(now())

  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  evidence        Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([observationId, evidenceId])
  @@index([observationId])
  @@index([evidenceId])
}

// ---- Phenomenon: evolving event tracked over time ----
model Phenomenon {
  id              String   @id @default(uuid())
  uuid            String   @unique
  type            String   // surface_disturbance | water_body_change | vegetation_loss | ...
  title           String
  summary         String
  // lifecycle
  status          String   @default("active") // emerging | active | growing | stabilizing | declining | resolved
  // spatial (current extent — may evolve)
  centroidLng     Float
  centroidLat     Float
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  currentAreaHa   Float
  // temporal
  firstObserved   DateTime
  lastObserved    DateTime
  durationDays    Float
  observationCount Int     @default(0)
  // evolution metrics
  growthRateHaPerWeek Float? // area growth rate
  growthPct       Float?   // percentage growth from first observation
  movementKm      Float?   // centroid movement from first to last
  persistenceScore Float?  // 0..1 how persistently detected
  // assessment (fused across all linked observations)
  confidence      Float    @default(0.5)
  uncertainty     Float    @default(0.2)
  severity        String   @default("moderate")
  // MGRS tile
  mgrsTile        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  observations    PhenomenonObservation[]

  @@index([type])
  @@index([status])
  @@index([centroidLng, centroidLat])
  @@index([firstObserved])
}

// Link observations to the phenomenon they belong to
model PhenomenonObservation {
  id              String   @id @default(uuid())
  phenomenonId    String
  observationId   String
  // temporal ordering
  sequence        Int      // 1 = first observation, 2 = next, etc.
  // change from previous observation in the phenomenon
  areaDeltaHa     Float?   // area change from previous
  areaDeltaPct    Float?
  centroidShiftKm Float?   // centroid movement from previous
  signalDelta     Float?   // fused signal change
  linkedAt        DateTime @default(now())

  phenomenon      Phenomenon @relation(fields: [phenomenonId], references: [id], onDelete: Cascade)
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([phenomenonId, observationId])
  @@index([phenomenonId])
  @@index([observationId])
}

// ---- Environmental Knowledge Graph (domain concepts) ----
// Separate from World Model. Connects environmental concepts with typed relationships.
model KnowledgeNode {
  id              String   @id @default(uuid())
  conceptId       String   @unique // "vegetation_loss" | "bare_soil" | "water_turbidity" | ...
  label           String
  category        String   // cause | effect | indicator | entity_type | condition
  description     String
  color           String   @default("#a1a1aa")
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  edgesFrom       KnowledgeEdge[] @relation("fromNode")
  edgesTo         KnowledgeEdge[] @relation("toNode")

  @@index([category])
}

model KnowledgeEdge {
  id              String   @id @default(uuid())
  fromNodeId      String
  toNodeId        String
  relation        String   // precedes | causes | indicates | affects | correlates_with | often_follows
  confidence      Float    @default(0.8) // domain knowledge confidence
  description     String
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  fromNode        KnowledgeNode @relation("fromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          KnowledgeNode @relation("toNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, relation])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([relation])
}

// ===== Milestone 4: Intelligence Engine =====
// Ranked competing hypotheses with Bayesian confidence, supporting +
// contradicting evidence, deterministic rules, decision traces, and
// scenario forecasting. NOT "AI deciding legality" — principled reasoning.

// ---- Evidence Bundle: groups evidence by category per observation ----
model EvidenceBundle {
  id              String   @id @default(uuid())
  observationId   String
  category        String   // vegetation | hydrology | infrastructure | terrain | atmospheric
  label           String   // "Vegetation Evidence" etc.
  evidenceCount   Int      @default(0)
  // aggregate metrics
  meanSignal      Float    @default(0)
  meanConfidence  Float    @default(0)
  fusedUncertainty Float   @default(0)
  // summary of what this bundle indicates
  indication      String   // "vegetation loss" | "bare soil increase" | "water change"
  // the evidence IDs in this bundle (JSON array)
  evidenceIds     String   @default("[]")
  createdAt       DateTime @default(now())

  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, category])
  @@index([observationId])
  @@index([category])
}

// ---- Hypothesis: ranked competing explanation for an observation ----
model Hypothesis {
  id              String   @id @default(uuid())
  uuid            String   @unique
  observationId   String
  // the hypothesis
  type            String   // "artisanal_mining" | "road_construction" | "flood_erosion" | "agricultural_expansion" | "quarrying" | "deforestation" | "natural_clearing"
  label           String   // "Possible artisanal mining activity"
  description     String   // human-readable explanation
  // Bayesian confidence
  prior           Float    // prior probability (from base rates / rules)
  posterior       Float    // posterior probability after evidence (0..1)
  confidence      Float    // final confidence = posterior normalized across competing hypotheses
  // ranking
  rank            Int      // 1 = most likely
  isPrimary       Boolean  @default(false) // top hypothesis
  // evidence counts
  supportingCount Int      @default(0)
  contradictingCount Int   @default(0)
  missingCount    Int      @default(0)
  // reasoning
  reasoning       String   // human-readable chain of reasoning
  recommendedVerification String // "Verify with high-resolution imagery" etc.
  status          String   @default("candidate") // candidate | confirmed | rejected | superseded
  // provenance
  rulesFired      String   @default("[]") // JSON: rule IDs that contributed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  evidence        HypothesisEvidence[]

  @@index([observationId])
  @@index([type])
  @@index([rank])
}

// Per-evidence contribution to a hypothesis: supports / contradicts / neutral
model HypothesisEvidence {
  id              String   @id @default(uuid())
  hypothesisId    String
  evidenceId      String?  // FK to Evidence (if standalone evidence)
  bundleId        String?  // FK to EvidenceBundle (if bundle-level)
  // relationship to the hypothesis
  relationship    String   // supports | contradicts | neutral
  // Bayesian contribution
  likelihoodRatio Float    // P(evidence|hypothesis) / P(evidence|¬hypothesis)
  posteriorContribution Float // log-odds contribution
  // explanation
  description     String   // why this evidence supports/contradicts
  weight          Float    // importance weight
  createdAt       DateTime @default(now())

  hypothesis      Hypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)

  @@index([hypothesisId])
  @@index([relationship])
}

// ---- Rules Engine: deterministic rules ----
model Rule {
  id              String   @id @default(uuid())
  ruleId          String   @unique // "rule-mining-01"
  name            String
  description     String
  // condition (JSON: evidence pattern to match)
  conditions      String   // JSON: [{bundle, indication, minSignal}]
  // effect: which hypothesis to boost/suppress
  hypothesisType  String   // "artisanal_mining"
  effect          String   // "boost" | "suppress"
  // Bayesian parameters
  likelihoodRatio Float    // how much to update
  priorAdjustment Float    @default(0) // adjustment to prior
  // metadata
  category        String   // "mining" | "infrastructure" | "natural" | "agriculture"
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([hypothesisType])
  @@index([category])
}

// ---- Scenario: predictive forecast ----
model Scenario {
  id              String   @id @default(uuid())
  uuid            String   @unique
  phenomenonId    String?  // linked phenomenon (if applicable)
  observationId   String?  // or linked observation
  hypothesisId    String?  // linked hypothesis
  // forecast
  type            String   // "trend_continuation" | "seasonal" | "intervention"
  label           String
  description     String
  // temporal
  forecastDays    Int      // 30, 60, 90
  // predicted state
  predictedAreaHa Float
  predictedGrowthPct Float
  // predicted impact
  affectedRiversCount Int   @default(0)
  affectedCommunitiesCount Int @default(0)
  expectedSedimentIncrease Float? // % expected sediment increase downstream
  // confidence
  confidence      Float    @default(0.5)
  uncertainty     Float    @default(0.2)
  // assumptions
  assumptions     String   @default("[]") // JSON array of assumption strings
  createdAt       DateTime @default(now())

  observation     Observation? @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([phenomenonId])
  @@index([observationId])
}

// ===== Milestone 5: Continuous Learning & Active Intelligence =====

// Spatial grid partition of Ghana — each tile is a fixed processing unit
model ProcessingTile {
  id              String   @id @default(uuid())
  tileId          String   @unique // "gh-grid-30NYM" or "gh-cell-001"
  // spatial extent
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  centroidLng     Float
  centroidLat     Float
  // grid coordinates
  gridRow         Int
  gridCol         Int
  // coverage
  mgrsTile        String?  // overlapping MGRS tile
  regionId        String?  // Ghana region
  // processing state
  lastProcessedAt DateTime?
  lastSceneId     String?  // last scene processed
  processingCount Int      @default(0)
  observationCount Int     @default(0)
  status          String   @default("pending") // pending | processing | processed | stale
  // last detected change
  lastChangeAt    DateTime?
  lastChangeType  String?  // observation type
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([mgrsTile])
  @@index([gridRow, gridCol])
}

// Feedback: confirmed/rejected outcomes from humans, government, community, ground truth
model FeedbackRecord {
  id              String   @id @default(uuid())
  observationId   String?
  hypothesisId    String?
  phenomenonId    String?
  // feedback
  outcome         String   // confirmed | rejected | needs_monitoring | partial
  feedbackType    String   // human_inspector | government | community | ground_truth | auto_validation
  // the confirmed/rejected hypothesis type (if applicable)
  hypothesisType  String?  // "artisanal_mining" etc.
  // reasoning
  notes           String?
  evidence        String   @default("{}") // JSON: supporting photos, reports, etc.
  // feedback provider
  providerId      String?  // user/org id
  providerRole    String?  // "inspector" | "official" | "community_member"
  credibility     Float    @default(0.8) // provider credibility score
  createdAt       DateTime @default(now())

  @@index([observationId])
  @@index([hypothesisId])
  @@index([outcome])
  @@index([feedbackType])
}

// Learning update: logged changes to priors, weights, thresholds from feedback
model LearningUpdate {
  id              String   @id @default(uuid())
  // what was updated
  updateType      String   // "prior" | "evidence_weight" | "threshold" | "rule_likelihood"
  targetId        String   // hypothesis type or rule id
  // old → new values
  oldValue        Float
  newValue        Float
  deltaPct        Float
  // why (which feedback triggered it)
  feedbackCount   Int      // number of feedback records used
  feedbackIds     String   @default("[]") // JSON
  // learning metrics
  accuracyBefore  Float?   // accuracy on feedback set before update
  accuracyAfter   Float?   // accuracy after update
  createdAt       DateTime @default(now())

  @@index([updateType])
  @@index([targetId])
}

// Continuous pipeline run log
model ProcessingRun {
  id              String   @id @default(uuid())
  startedAt       DateTime
  finishedAt      DateTime?
  status          String   @default("running") // running | success | partial | failed
  tilesProcessed  Int      @default(0)
  tilesTotal      Int      @default(0)
  scenesProcessed Int      @default(0)
  observationsCreated Int  @default(0)
  observationsUpdated Int  @default(0)
  hypothesesCreated Int    @default(0)
  phenomenaCreated Int     @default(0)
  durationMs      Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([startedAt])
}

// Learned priors (dynamic — updated by the learning engine)
model LearnedPrior {
  id              String   @id @default(uuid())
  hypothesisType  String   @unique
  originalPrior   Float    // base-rate prior from HYPOTHESIS_DEFS
  learnedPrior    Float    // current learned prior
  // accuracy metrics
  confirmations   Int      @default(0) // times this hypothesis was confirmed
  rejections      Int      @default(0) // times rejected
  falsePositives  Int      @default(0)
  falseNegatives  Int      @default(0)
  accuracy        Float    @default(0.5) // running accuracy
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([hypothesisType])
}

// ===== Milestone 5.25: Ground Truth & Active Learning =====

// Human Review Queue — structured workflow for verification
model ReviewQueue {
  id              String   @id @default(uuid())
  observationId   String
  hypothesisId    String?  // specific hypothesis to review
  // queue state
  status          String   @default("needs_review") // needs_review | assigned | reviewed | ground_truth | skipped
  priority        String   @default("normal") // low | normal | high | urgent
  priorityScore   Float    @default(0.5) // 0..1, higher = more important to review
  // active learning
  uncertaintyScore Float   @default(0.5) // how uncertain the AI is
  informationGain Float    @default(0) // expected information gain from reviewing
  // assignment
  assignedTo      String?  // reviewer id
  assignedAt      DateTime?
  // review result
  reviewOutcome   String?  // confirmed | rejected | partial | needs_monitoring
  reviewNotes     String?
  reviewEvidence  String   @default("{}") // JSON: photos, drone scans, etc.
  reviewedAt      DateTime?
  reviewedBy      String?
  // timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([observationId])
}

// Ground Truth — verified outcomes linked to observations/hypotheses
model GroundTruth {
  id              String   @id @default(uuid())
  observationId   String?
  hypothesisId    String?
  phenomenonId    String?
  // the verified truth
  verifiedOutcome String   // confirmed | rejected | partial
  verifiedHypothesisType String? // which hypothesis was correct
  // verification method
  verificationMethod String // field_inspection | drone_survey | government_confirmation | community_verification | multi_source
  confidence      Float    @default(1.0) // ground truth confidence (1.0 = certain)
  // evidence
  evidenceSummary String   // text description of verification evidence
  evidenceData    String   @default("{}") // JSON: photos, coordinates, reports
  // verifier
  verifiedBy      String?
  verifierRole    String?  // inspector | official | community_lead | ai_auto
  verifierCredibility Float @default(0.8)
  // learning link
  learningApplied Boolean  @default(false) // has this been fed to the learning engine?
  createdAt       DateTime @default(now())

  @@index([observationId])
  @@index([verifiedOutcome])
  @@index([verificationMethod])
}

// Calibration metrics — tracked over time
model CalibrationMetric {
  id              String   @id @default(uuid())
  // what's being calibrated
  hypothesisType  String?  // null = global
  metricType      String   // brier_score | ece | precision | recall | f1 | accuracy
  value           Float
  // context
  sampleCount     Int
  timeWindow      String   // "7d" | "30d" | "all"
  computedAt      DateTime @default(now())

  @@index([hypothesisType])
  @@index([metricType])
  @@index([computedAt])
}

// Evidence Quality Score — per-evidence quality assessment
model EvidenceQualityScore {
  id              String   @id @default(uuid())
  evidenceId      String   @unique
  // quality factors (0..1 each)
  sensorReliability Float   @default(0.9) // sentinel-2 = high
  cloudCover      Float    @default(0) // 0..100
  ageDays         Float    @default(0) // how old
  resolution      Float    @default(10) // meters
  distanceToTarget Float   @default(0) // km
  humanCredibility Float   @default(0.8)
  crossSourceAgreement Float @default(0.5) // 0..1
  // computed quality
  qualityScore    Float    @default(0.5) // 0..1 composite
  qualityFactors  String   @default("{}") // JSON breakdown
  createdAt       DateTime @default(now())

  @@index([evidenceId])
  @@index([qualityScore])
}

// Drift detection — distribution shift monitoring
model DriftAlert {
  id              String   @id @default(uuid())
  type            String   // seasonal | distribution | sensor | anomaly_pattern
  metric          String   // what drifted
  baselineValue   Float
  currentValue    Float
  driftMagnitude  Float    // % change
  threshold       Float    // alert threshold
  status          String   @default("active") // active | acknowledged | resolved
  description     String
  affectedTiles   String   @default("[]") // JSON
  detectedAt      DateTime @default(now())
  resolvedAt      DateTime?

  @@index([status])
  @@index([type])
  @@index([detectedAt])
}

// Benchmark report — periodic performance summary
model BenchmarkReport {
  id              String   @id @default(uuid())
  period          String   // "2025-01" or "2025-W03"
  periodStart     DateTime
  periodEnd       DateTime
  // metrics
  detectionAccuracy Float
  falsePositiveRate Float
  falseNegativeRate Float
  avgCalibrationError Float
  timeToConfirmation Float? // hours
  humanWorkloadHours Float
  learningImprovement Float // % accuracy change
  avgUncertainty  Float
  coveragePct     Float
  // details
  observationsCount Int
  groundTruthCount Int
  reviewQueueSize Int
  metrics         String   @default("{}") // JSON: per-hypothesis breakdown
  createdAt       DateTime @default(now())

  @@index([period])
}

// Model version — for reproducibility
model ModelVersion {
  id              String   @id @default(uuid())
  versionId       String   @unique // "hypothesis-model-v12"
  component       String   // "hypothesis_engine" | "raster_intelligence" | "baseline" | "learning_state"
  description     String
  // state snapshot
  stateHash       String?  // hash of model state for reproducibility
  parameters      String   @default("{}") // JSON: priors, weights, thresholds
  // parentage
  parentVersionId String?
  createdAt       DateTime @default(now())

  @@index([component])
  @@index([createdAt])
}

// ===== Milestone 5.75: Multi-Modal Evidence Fusion & Feature Store =====

// Feature Store — per-cell feature vectors, reusable across the platform
model FeatureVector {
  id              String   @id @default(uuid())
  tileId          String   // FK to ProcessingTile
  // spatial reference
  centroidLng     Float
  centroidLat     Float
  // temporal
  computedAt      DateTime
  sceneId         String?  // source scene (if applicable)
  // multi-modal features (each modality contributes features)
  // optical (Sentinel-2 derived)
  ndvi            Float?
  ndwi            Float?
  nbr             Float?
  evi             Float?
  bsi             Float?
  mndwi           Float?
  savi            Float?
  // sar (Sentinel-1 derived — metadata-based until SAR connector built)
  sarBackscatter  Float?   // VV dB
  sarCoherence    Float?   // 0..1
  sarRoughness    Float?   // surface roughness index
  // thermal (Landsat derived)
  thermalAnomaly  Float?   // temperature deviation
  // weather (CHIRPS / ERA5)
  rainfall7d      Float?   // mm last 7 days
  rainfallAnomaly Float?   // deviation from seasonal norm
  temperature     Float?   // °C
  soilMoisture    Float?   // ERA5 derived
  // terrain (DEM derived)
  elevation       Float?   // meters
  slope           Float?   // degrees
  aspect          Float?   // degrees
  flowAccumulation Float?  // upstream area
  erosionSusceptibility Float? // 0..1
  // hydrology
  distanceToRiver Float?   // km to nearest river
  riverProximity  Float?   // 0..1 (1 = on riverbank)
  downstreamConnected Boolean @default(false)
  // infrastructure
  distanceToRoad  Float?   // km
  distanceToSettlement Float? // km
  nightLights     Float?   // radiance
  builtUpIndex    Float?   // 0..1
  // human activity
  populationDensity Float? // people/km²
  settlementGrowthRate Float? // % annual
  // composite quality
  cloudCover      Float?   // % at observation time
  dataCompleteness Float?  // 0..1 fraction of modalities with data
  // feature vector hash for dedup
  vectorHash      String?
  createdAt       DateTime @default(now())

  @@index([tileId])
  @@index([computedAt])
  @@index([centroidLng, centroidLat])
}

// National Feature Cube — temporal sequence of feature vectors per cell
model FeatureCubeCell {
  id              String   @id @default(uuid())
  tileId          String   @unique // one cell per tile
  // current state (latest feature vector)
  currentFeatureVectorId String?
  // temporal sequences (JSON arrays of feature vector IDs, most recent first)
  weeklyHistory   String   @default("[]") // last 12 weeks
  monthlyHistory  String   @default("[]") // last 12 months
  seasonalHistory String   @default("[]") // last 5 seasons
  // trend metrics
  ndviTrend       Float?   // slope of NDVI over time
  ndviTrendPct    Float?   // % change
  waterTrend      Float?
  bareSoilTrend   Float?
  settlementTrend Float?
  // anomaly flags
  anomalyScore    Float    @default(0) // 0..1 composite
  isAnomalous     Boolean  @default(false)
  anomalyType     String?  // "vegetation_loss" | "water_change" | "urban_growth" etc.
  lastAnomalyAt   DateTime?
  // update tracking
  lastUpdated     DateTime @default(now())
  updateCount     Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([tileId])
  @@index([isAnomalous])
  @@index([anomalyScore])
}

// Digital Twin State Engine — per-cell persistent state
model TwinState {
  id              String   @id @default(uuid())
  tileId          String   @unique
  // physical state
  landCover       String?  // current dominant land cover class
  vegetationHealth Float?  // 0..1
  waterExtent     Float?   // ha
  bareSoilExtent  Float?   // ha
  // environmental state
  rainfallRecent  Float?   // mm
  temperatureRecent Float?
  soilMoistureRecent Float?
  season          String?  // "rainy" | "dry" | "transitional"
  // human activity state
  settlementArea  Float?   // ha
  roadDensity     Float?   // km/km²
  nightLightsIntensity Float?
  populationEstimate Float?
  // observation history
  observationCount Int     @default(0)
  lastObservationAt DateTime?
  lastObservationType String?
  // phenomena history
  activePhenomenaCount Int @default(0)
  // risk state
  riskLevel       String   @default("low") // low | moderate | high | critical
  riskScore       Float    @default(0) // 0..1
  riskFactors     String   @default("[]") // JSON: [{factor, weight}]
  // forecast state
  forecastArea30d Float?   // predicted area in 30 days
  forecastConfidence Float? // 0..1
  // confidence state
  overallConfidence Float  @default(0.5)
  dataQualityScore Float  @default(0.5)
  // metadata
  lastUpdated     DateTime @default(now())
  updateCount     Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([tileId])
  @@index([riskLevel])
  @@index([riskScore])
}

// Modality source registry — tracks which modalities are available
model ModalitySource {
  id              String   @id @default(uuid())
  modalityId      String   @unique // "sentinel-2-optical" | "sentinel-1-sar" | "landsat-thermal" | "chirps-weather" | "era5" | "srtm-dem" | "hydrosheds" | "nightlights" | "population"
  name            String
  category        String   // optical | sar | thermal | weather | dem | hydrology | infrastructure | human_activity
  sensor          String?  // "MSI" | "C-SAR" | "TIRS" etc.
  platform        String?  // "Sentinel-2" | "Sentinel-1" | "Landsat-8"
  resolution      String?  // "10m" | "30m" etc.
  cadence         String?  // "5 days" | "daily"
  status          String   @default("registered") // registered | active | degraded
  // what features it contributes
  featuresProvided String  @default("[]") // JSON: ["ndvi", "ndwi"]
  // coverage
  coveragePct     Float    @default(0)
  lastDataAt      DateTime?
  description     String
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([status])
}

// ===== Milestone 6: Autonomous Mission Planning & Data Acquisition =====
// The platform actively decides what evidence it needs next and creates missions
// to acquire it. Closes the intelligence loop: observe → reason → plan → collect → re-observe.

model Mission {
  id              String   @id @default(uuid())
  uuid            String   @unique
  // what triggered the mission
  observationId   String?
  hypothesisId    String?
  phenomenonId    String?
  tileId          String?  // target processing tile
  // mission type
  type            String   // satellite_revisit | drone | community | inspector | iot | sar_tasking
  title           String
  description     String
  // target
  targetLng       Float
  targetLat       Float
  targetRadiusM   Float    // coverage radius in meters
  // mission parameters (JSON — type-specific)
  parameters      String   @default("{}") // altitude, sensor, checklist, etc.
  // Expected Value of Information
  informationGain Float    @default(0) // expected uncertainty reduction (0..1)
  cost            Float    @default(0) // estimated cost ($)
  evi             Float    @default(0) // EVI = informationGain / cost
  // priority
  priority        String   @default("normal") // low | normal | high | urgent
  priorityScore   Float    @default(0.5) // 0..1
  // lifecycle
  status          String   @default("planned") // planned | assigned | in_progress | completed | cancelled | failed
  assignedTo      String?  // who/what is executing
  assignedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  // results
  outcome         String?  // success | partial | failure
  evidenceCollected String  @default("{}") // JSON: collected evidence
  uncertaintyBefore Float? // hypothesis uncertainty before mission
  uncertaintyAfter  Float? // uncertainty after mission (if completed)
  actualInformationGain Float? // measured (not estimated) info gain
  // reasoning
  reasoning       String   // why this mission was created
  missingEvidence String   @default("[]") // JSON: what evidence was missing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([observationId])
  @@index([hypothesisId])
  @@index([evi])
}

// Autonomous observation scheduling — tile frequency assignment
model ObservationSchedule {
  id              String   @id @default(uuid())
  tileId          String   @unique
  // frequency tier
  tier            String   @default("low") // high | medium | low
  frequency       String   @default("monthly") // daily | weekly | monthly | quarterly
  // rationale
  priorityScore   Float    @default(0) // 0..1, higher = more important to monitor
  riskScore       Float    @default(0)
  changeRate      Float    @default(0) // how fast this tile changes
  lastObservationCount Int  @default(0)
  lastPhenomenaCount Int   @default(0)
  // scheduling
  nextObservationAt DateTime?
  lastScheduledAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tier])
  @@index([priorityScore])
}

// ===== Milestone 6.5: Production Validation & Scientific Evaluation =====

// Replay run — end-to-end pipeline replay for regression testing
model ReplayRun {
  id              String   @id @default(uuid())
  sceneId         String?  // scene replayed (if applicable)
  tileId          String?  // tile replayed (if applicable)
  // what was replayed
  scope           String   // "scene" | "tile" | "full_pipeline"
  // stages executed
  stagesCompleted String   @default("[]") // JSON: ["ingest", "indices", "products", "evidence", "observations", "hypotheses"]
  stagesFailed    String   @default("[]") // JSON
  // timing
  startedAt       DateTime
  finishedAt      DateTime?
  durationMs      Int      @default(0)
  // results
  status          String   @default("running") // running | success | partial | failed
  observationsCreated Int   @default(0)
  hypothesesCreated Int    @default(0)
  error           String?
  // comparison (if replaying against known outcomes)
  comparisonResult String  @default("{}") // JSON: { matched, mismatched, new }
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([scope])
  @@index([startedAt])
}

// Benchmark dataset — labeled ground truth for scientific evaluation
model BenchmarkSample {
  id              String   @id @default(uuid())
  datasetName     String   // "ghana_mining_2024" | "seasonal_agriculture" | "floods"
  // location
  centroidLng     Float
  centroidLat     Float
  mgrsTile        String?
  regionId        String?
  // label (ground truth)
  labelType       String   // "mining" | "agriculture" | "flood" | "logging" | "construction" | "bare_rock" | "reservoir" | "natural"
  isConfirmed     Boolean  @default(true) // verified ground truth
  // temporal
  eventDate       DateTime?
  // biome context
  biome           String?  // "forest" | "savanna" | "coastal" | "wetland" | "urban"
  // expected properties
  expectedAreaHa  Float?
  // notes
  notes           String?
  source          String?  // "government" | "inspector" | "research" | "community"
  createdAt       DateTime @default(now())

  @@index([datasetName])
  @@index([labelType])
  @@index([biome])
}

// Evaluation result — scientific metrics per evaluation run
model EvaluationResult {
  id              String   @id @default(uuid())
  datasetName     String
  // metrics
  precision       Float
  recall          Float
  f1Score         Float
  auroc           Float?
  brierScore      Float?
  ece             Float?   // Expected Calibration Error
  // per-class breakdown
  perClassMetrics String   @default("{}") // JSON: { mining: {precision, recall, f1}, agriculture: {...} }
  // per-biome breakdown
  perBiomeMetrics String   @default("{}") // JSON: { forest: {fp, fn, tp, tn}, savanna: {...} }
  // counts
  truePositives   Int
  falsePositives  Int
  trueNegatives   Int
  falseNegatives  Int
  sampleCount     Int
  // timing
  evaluatedAt     DateTime @default(now())

  @@index([datasetName])
  @@index([evaluatedAt])
}

// Pipeline metric — observability for every stage
model PipelineMetric {
  id              String   @id @default(uuid())
  stage           String   // "ingest" | "raster_read" | "index_compute" | "product_compute" | "evidence_extract" | "observation_scan" | "hypothesis_gen" | "mission_plan" | "learning"
  metricName      String   // "count" | "duration_ms" | "latency_p95" | "error_rate" | "throughput"
  value           Float
  unit            String   @default("") // "items" | "ms" | "items/hr" | "%"
  // context
  context         String   @default("{}") // JSON: { tileId, sceneId, type }
  recordedAt      DateTime @default(now())

  @@index([stage])
  @@index([metricName])
  @@index([recordedAt])
}

// Cache entry — for performance engineering
model CacheEntry {
  id              String   @id @default(uuid())
  cacheKey        String   @unique
  cacheType       String   // "raster_read" | "stac_query" | "feature_vector" | "product_stats" | "bandit" | "scene_index"
  value           String   // JSON serialized cached value
  ttlSeconds      Int      @default(300)
  hitCount        Int      @default(0)
  sizeBytes       Int      @default(0)
  createdAt       DateTime @default(now())
  lastAccessedAt  DateTime @default(now())

  @@index([cacheKey])
  @@index([cacheType])
}

// ===== Milestone 6.5+: Validation Gates (SLOs, Lineage Audit, Drift Actions, Deterministic Replay) =====

// Service-Level Objective — measurable production targets
model SLO {
  id              String   @id @default(uuid())
  sloId           String   @unique // "scene_ingestion" | "product_generation" etc.
  name            String
  description     String
  // metric
  metricName      String   // "duration_ms" | "success_rate" | "availability"
  target          Float    // target value (e.g. 600000 ms = 10 min, or 0.999 = 99.9%)
  targetDirection String   @default("less") // "less" (below target is good) | "greater" (above is good)
  unit            String   @default("") // "ms" | "%" | "ratio"
  category        String   // "engineering" | "scientific"
  // window
  windowHours     Int      @default(24) // measurement window
  // current status
  currentValue    Float?   @default(0)
  status          String   @default("unknown") // met | violated | unknown | warning
  lastMeasuredAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  measurements    SLOMeasurement[]

  @@index([category])
  @@index([status])
}

// SLO measurement history — track SLO compliance over time
model SLOMeasurement {
  id              String   @id @default(uuid())
  sloId           String
  slo             SLO      @relation(fields: [sloId], references: [id], onDelete: Cascade)
  value           Float
  status          String   // met | violated | warning
  measuredAt      DateTime @default(now())

  @@index([sloId])
  @@index([measuredAt])
}

// Lineage audit — completeness of the provenance chain per observation
model LineageAudit {
  id              String   @id @default(uuid())
  observationId   String   @unique
  // completeness checks (each stage of the chain)
  hasEvidence     Boolean  @default(false)
  hasRasterProduct Boolean @default(false)
  hasBaseline     Boolean  @default(false)
  hasScene        Boolean  @default(false)
  hasCOG          Boolean  @default(false)
  hasSTAC         Boolean  @default(false)
  // overall
  completenessPct Float    @default(0) // 0..100
  missingStages   String   @default("[]") // JSON: ["baseline", "cog"]
  auditedAt       DateTime @default(now())

  @@index([completenessPct])
  @@index([observationId])
}

// Drift action — operational workflow triggered by drift detection
model DriftAction {
  id              String   @id @default(uuid())
  driftAlertId    String?  // FK to DriftAlert
  actionType      String   // "increase_review_sampling" | "reduce_confidence" | "increase_sar_priority" | "notify_analysts" | "retrain_priors"
  description     String
  // action parameters
  parameters      String   @default("{}") // JSON: how much to increase, who to notify, etc.
  // execution
  status          String   @default("pending") // pending | executed | skipped | failed
  executedAt      DateTime?
  result          String?  // execution result summary
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([actionType])
}

// Replay version — deterministic replay records all versions for reproducibility
model ReplayVersion {
  id              String   @id @default(uuid())
  replayRunId     String?  // FK to ReplayRun
  // versions recorded at replay time
  codeVersion     String?  // git commit hash
  schemaVersion   String?  // prisma schema hash
  ruleVersion     String?  // rule set version
  modelVersion    String?  // hypothesis model version
  connectorVersions String @default("{}") // JSON: {geoboundaries: "2024-01", osm: "2024-08-01", stac: "sentinel-2-l2a"}
  datasetVersions String   @default("{}") // JSON: {baseline: "v5", worldcover: "2021"}
  configSnapshot  String   @default("{}") // JSON: thresholds, priors, weights at replay time
  environment     String   @default("production") // production | staging | development
  createdAt       DateTime @default(now())

  @@index([replayRunId])
}

// Benchmark diversity tag — ensures benchmark coverage across conditions
model BenchmarkDiversityTag {
  id              String   @id @default(uuid())
  benchmarkSampleId String
  // diversity dimensions
  season          String?  // "dry" | "rainy" | "transitional"
  biome           String?  // "forest" | "savanna" | "wetland" | "urban" | "coastal" | "mining" | "agriculture"
  topoPosition    String?  // "lowland" | "upland" | "riparian" | "plateau"
  cloudCondition  String?  // "clear" | "cloudy" | "mixed"
  // difficulty
  difficulty      String?  // "easy" | "moderate" | "hard" // how hard to detect
  notes           String?
  createdAt       DateTime @default(now())

  @@index([benchmarkSampleId])
  @@index([season])
  @@index([biome])
}

// ===== Milestone 6.75: Extension Platform =====
// The core platform is domain-agnostic. Domain expertise (mining, floods,
// agriculture, forestry) lives in installable extensions with manifests,
// permissions, and a sandboxed SDK.

model Extension {
  id              String   @id @default(uuid())
  extensionId     String   @unique // "illegal-mining" | "flood-monitoring" | "cocoa-agriculture"
  name            String
  version         String   // semver "2.1.0"
  description     String
  author          String
  category        String   // "mining" | "flood" | "agriculture" | "forestry" | "infrastructure" | "biodiversity" | "custom"
  // status
  status          String   @default("installed") // available | installed | enabled | disabled | error
  installedAt     DateTime @default(now())
  enabledAt       DateTime?
  // manifest (full YAML-like JSON manifest)
  manifest        String   @default("{}") // JSON: full extension manifest
  // permissions
  permissions     String   @default("{}") // JSON: datasets, compute, ui, missions, alerts
  // what the extension contributes
  ruleCount       Int      @default(0)
  hypothesisTypes String   @default("[]") // JSON: types this extension defines
  missionTypes    String   @default("[]") // JSON: mission types
  uiViews         String   @default("[]") // JSON: UI views contributed
  observationTypes String  @default("[]") // JSON: observation types
  // trust
  isSigned        Boolean  @default(false)
  isVerified      Boolean  @default(false)
  trustScore      Float    @default(0.5) // 0..1
  // metadata
  icon            String   @default("puzzle")
  color           String   @default("#a78bfa")
  tags            String   @default("[]") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rules           ExtensionRule[]
  configs         ExtensionConfig[]

  @@index([status])
  @@index([category])
}

model ExtensionRule {
  id              String   @id @default(uuid())
  extensionId     String   // FK to Extension.extensionId (string slug)
  ruleId          String   // "illegal-mining-rule-01"
  name            String
  description     String
  // rule definition
  conditions      String   @default("[]") // JSON: evidence patterns
  hypothesisType  String   // what hypothesis this rule supports
  effect          String   // "boost" | "suppress"
  likelihoodRatio Float    // Bayesian LR
  priority        Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  extension       Extension @relation(fields: [extensionId], references: [extensionId], onDelete: Cascade)

  @@index([extensionId])
  @@index([hypothesisType])
}

model ExtensionConfig {
  id              String   @id @default(uuid())
  extensionId     String
  key             String   // config key
  value           String   // config value (JSON)
  description     String?
  updatedAt       DateTime @updatedAt

  extension       Extension @relation(fields: [extensionId], references: [extensionId], onDelete: Cascade)

  @@unique([extensionId, key])
  @@index([extensionId])
}

// ===== Milestone 6.75+: Advanced Extension Platform =====
// Lifecycle hooks, declarative pipelines, dependency management, versioned APIs,
// resource limits, trust model, data contracts, replay testing.

// Extension dependency — semver resolution between extensions
model ExtensionDependency {
  id              String   @id @default(uuid())
  extensionId     String   // the extension that depends on something
  dependsOnId     String   // the extension it depends on
  versionRange    String   // ">=2.0" | "^1.5" | "*"
  required        Boolean  @default(true) // hard vs optional dependency
  createdAt       DateTime @default(now())

  @@unique([extensionId, dependsOnId])
  @@index([extensionId])
  @@index([dependsOnId])
}

// Extension lifecycle hook — formal extension points
model ExtensionHook {
  id              String   @id @default(uuid())
  extensionId     String   // FK to Extension.extensionId
  hookName        String   // "datasets" | "features" | "evidence" | "observations" | "hypotheses" | "missions" | "learning" | "views" | "commands"
  hookType        String   // "pipeline_stage" | "ui_contribution" | "command"
  // execution metadata
  priority        Int      @default(0) // lower = runs first
  enabled         Boolean  @default(true)
  // the hook's contribution (JSON — varies by hookType)
  contribution    String   @default("{}") // JSON: what this hook contributes
  createdAt       DateTime @default(now())

  @@unique([extensionId, hookName])
  @@index([extensionId])
  @@index([hookName])
}

// Extension pipeline — declarative processing stages
model ExtensionPipeline {
  id              String   @id @default(uuid())
  extensionId     String
  name            String   // pipeline name
  // declarative stages (JSON array of stage definitions)
  stages          String   @default("[]") // JSON: [{stage, input, output, config}]
  stageCount      Int      @default(0)
  // execution metadata
  cacheable       Boolean  @default(true)
  parallelizable  Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([extensionId])
}

// Extension data contract — what it consumes and produces
model ExtensionContract {
  id              String   @id @default(uuid())
  extensionId     String   @unique
  // consumes (JSON arrays of type names)
  consumes        String   @default("[]") // JSON: ["Observation", "RasterProduct", "Weather"]
  produces        String   @default("[]") // JSON: ["MiningObservation", "Mission", "Alert"]
  // validation status
  validated       Boolean  @default(false)
  validationErrors String  @default("[]") // JSON: missing inputs, type mismatches
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([extensionId])
}

// Extension resource limit — quotas per extension
model ExtensionResourceLimit {
  id              String   @id @default(uuid())
  extensionId     String   @unique
  // quotas
  cpuMs           Int      @default(500) // max CPU time per invocation
  memoryMB        Int      @default(512)
  networkEnabled  Boolean  @default(false)
  maxRasterReads  Int      @default(1000) // per pipeline run
  maxFeatureWrites Int     @default(100)
  maxApiCalls     Int      @default(500) // SDK calls per invocation
  // tracking
  currentRasterReads Int   @default(0)
  currentApiCalls  Int     @default(0)
  lastResetAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([extensionId])
}

// Extension test — replay tests shipped with the extension
model ExtensionTest {
  id              String   @id @default(uuid())
  extensionId     String
  testName        String   // "evidence.test" | "rules.test" | "replay.test"
  testType        String   // "unit" | "integration" | "replay"
  description     String
  // test definition (JSON: input, expected output, comparison)
  definition      String   @default("{}")
  // last run result
  lastRunAt       DateTime?
  lastResult      String?  // "passed" | "failed" | "skipped"
  lastDuration    Int?     // ms
  lastDiff        String?  // JSON: differences from expected output
  createdAt       DateTime @default(now())

  @@index([extensionId])
  @@index([testType])
}

// Extension trust metadata — extended trust model
model ExtensionTrust {
  id              String   @id @default(uuid())
  extensionId     String   @unique
  // publisher
  publisher       String?
  publisherVerified Boolean @default(false)
  // signature
  signatureHash   String?
  signatureVerified Boolean @default(false)
  // review
  reviewedBy      String?  // "Ghana EPA" | "University of Ghana"
  reviewDate      DateTime?
  reviewStatus    String?  // "approved" | "pending" | "rejected"
  // scientific
  reproducibilityScore Float? // 0..1
  scientificValidation String? // "peer-reviewed" | "preprint" | "internal" | "none"
  peerReviewUrl   String?
  // trust level
  trustLevel      String   @default("community") // "official" | "verified" | "community" | "experimental"
  trustScore      Float    @default(0.5) // composite 0..1
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([extensionId])
  @@index([trustLevel])
}

// ===== Platform Kernel: Capability System + Dynamic Registries =====
// The core is domain-agnostic. Extensions register hypothesis types, rules,
// mission types dynamically. The Capability System enforces permissions
// before every SDK call — the security boundary for the entire platform.

// Capability — a permission that can be granted to an extension
model Capability {
  id              String   @id @default(uuid())
  capabilityId    String   @unique // "dataset:read:sentinel2" | "observation:emit" | "mission:create"
  category        String   // "dataset" | "observation" | "mission" | "feature" | "scene" | "learning" | "alert" | "ui" | "filesystem" | "network" | "compute"
  description     String
  riskLevel       String   @default("low") // "low" | "medium" | "high" | "critical"
  requiresApproval Boolean @default(false) // if true, requires manual approval
  createdAt       DateTime @default(now())

  grants          CapabilityGrant[]

  @@index([category])
  @@index([riskLevel])
}

// Capability Grant — what capabilities an extension has been granted
model CapabilityGrant {
  id              String   @id @default(uuid())
  extensionId     String   // FK to Extension.extensionId
  capabilityId    String   // FK to Capability.capabilityId
  granted         Boolean  @default(false)
  grantedAt       DateTime?
  grantedBy       String?  // who approved
  // usage tracking
  invocationCount Int      @default(0)
  lastInvokedAt   DateTime?
  // rate limiting
  rateLimitPerMin Int?     // max invocations per minute
  createdAt       DateTime @default(now())

  capability      Capability @relation(fields: [capabilityId], references: [capabilityId], onDelete: Cascade)

  @@unique([extensionId, capabilityId])
  @@index([extensionId])
  @@index([granted])
}

// Dynamic Hypothesis Type — registered by extensions, not hardcoded
model DynamicHypothesisType {
  id              String   @id @default(uuid())
  typeId          String   @unique // "artisanal_mining" | "flood_erosion" | "cocoa_stress"
  extensionId     String   // which extension registered this
  label           String
  description     String
  prior           Float    @default(0.15)
  recommendedVerification String?
  // metadata
  category        String   // from extension category
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([extensionId])
  @@index([category])
  @@index([enabled])
}

// Dynamic Rule — registered by extensions
model DynamicRule {
  id              String   @id @default(uuid())
  ruleId          String   @unique // "mining-001"
  extensionId     String
  name            String
  description     String
  // declarative rule (YAML-like JSON)
  conditions      String   @default("[]") // JSON: [{bundle, indication, minSignal, productType}]
  hypothesisType  String   // which dynamic hypothesis type this supports
  effect          String   @default("boost") // "boost" | "suppress"
  likelihoodRatio Float    @default(1.0)
  priority        Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([extensionId])
  @@index([hypothesisType])
  @@index([enabled])
}

// Dynamic Mission Type — registered by extensions
model DynamicMissionType {
  id              String   @id @default(uuid())
  typeId          String   @unique // "sar_tasking" | "river_gauge" | "farmer_survey"
  extensionId     String
  label           String
  description     String
  baseCost        Float    @default(0)
  baseInfoGain    Float    @default(0.3)
  estimatedTime   String   @default("1-2 hours")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([extensionId])
  @@index([enabled])
}

// Extension package metadata — standardized layout
model ExtensionPackage {
  id              String   @id @default(uuid())
  extensionId     String   @unique
  // package structure validation
  hasManifest     Boolean  @default(false)
  hasRules        Boolean  @default(false)
  hasHypotheses   Boolean  @default(false)
  hasMissions     Boolean  @default(false)
  hasUI           Boolean  @default(false)
  hasAgents       Boolean  @default(false)
  hasTests        Boolean  @default(false)
  hasKnowledge    Boolean  @default(false)
  // file count
  totalFiles      Int      @default(0)
  totalSize       Int      @default(0) // bytes
  // validation
  structureValid  Boolean  @default(false)
  validationErrors String  @default("[]")
  validatedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([structureValid])
}

// ===== Platform Orchestration: Composable Packages, Artifacts, Events, DAGs, Policies =====

// Typed Contribution — unified registry replacing separate Dynamic* tables
model TypedContribution {
  id              String   @id @default(uuid())
  contributionId  String   @unique // "illegal-mining:rule:mining-001"
  packageId       String   // which package contributed this
  kind            String   // "rule" | "hypothesis_type" | "mission_type" | "observation_type" | "ui_view" | "widget" | "dashboard" | "command" | "workflow" | "ontology" | "agent" | "model" | "pipeline_stage" | "alert_type" | "report" | "scheduler" | "validator" | "exporter" | "prompt" | "tool" | "policy"
  // versioned
  version         String   @default("1.0.0")
  apiVersion      String   @default("v1")
  // payload (JSON — type-specific)
  payload         String   @default("{}")
  // composition
  composesFrom    String   @default("[]") // JSON: contribution IDs this composes from
  // trust
  signature       String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([packageId])
  @@index([kind])
  @@index([enabled])
}

// Artifact — unified provenance store for everything the platform produces
model Artifact {
  id              String   @id @default(uuid())
  artifactId      String   @unique
  kind            String   // "observation" | "evidence" | "hypothesis" | "mission" | "scenario" | "report" | "benchmark" | "replay" | "phenomenon" | "ground_truth" | "alert" | "feature_vector" | "raster_product"
  // ownership
  ownerPackage    String?  // which package created this
  createdBy       String?  // system | extension:illegal-mining | user:inspector
  // lineage
  parentIds       String   @default("[]") // JSON: artifact IDs this was derived from
  lineageHash     String?  // hash of full lineage chain
  // versioning
  version         Int      @default(1)
  currentVersion  Boolean  @default(true)
  // metadata
  metadata        String   @default("{}") // JSON: type-specific metadata
  // temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([kind])
  @@index([ownerPackage])
  @@index([currentVersion])
  @@index([createdAt])
}

// Platform Package — replaces "extension" with composable packages
model PlatformPackage {
  id              String   @id @default(uuid())
  packageId       String   @unique // "sentinel-2-connector" | "bayesian-reasoner" | "illegal-mining"
  name            String
  version         String   // semver
  description     String
  author          String
  kind            String   @default("extension") // "dataset" | "connector" | "feature_extractor" | "rule_library" | "reasoning" | "mission_library" | "ui" | "dashboard" | "ontology" | "workflow" | "agent" | "model" | "domain" | "extension" | "theme" | "profile"
  // composition
  composes        String   @default("[]") // JSON: package IDs this composes from
  dependsOn       String   @default("[]") // JSON: {packageId, versionRange, required}
  // status
  status          String   @default("available") // available | installed | enabled | disabled
  installedAt     DateTime?
  enabledAt       DateTime?
  // trust
  trustLevel      String   @default("community")
  trustScore      Float    @default(0.5)
  publisherVerified Boolean @default(false)
  // metadata
  icon            String   @default("package")
  color           String   @default("#a78bfa")
  tags            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([trustLevel])
}

// Package Profile — bundles compatible packages into installable solutions
model PackageProfile {
  id              String   @id @default(uuid())
  profileId       String   @unique // "ghana-illegal-mining" | "national-flood-monitoring"
  name            String
  description     String
  // packages included
  packages        String   @default("[]") // JSON: [{packageId, versionRange}]
  // profile metadata
  author          String
  version         String   @default("1.0.0")
  icon            String   @default("layers")
  color           String   @default("#34d399")
  tags            String   @default("[]")
  // status
  status          String   @default("available") // available | installed
  installedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([status])
}

// Workflow — reusable processing workflows
model Workflow {
  id              String   @id @default(uuid())
  workflowId      String   @unique // "review" | "mission-planning" | "verification"
  name            String
  description     String
  ownerPackage    String?  // which package owns this (null = built-in)
  // DAG definition (JSON: nodes + edges)
  nodes           String   @default("[]") // JSON: [{id, type, packageId, config}]
  edges           String   @default("[]") // JSON: [{from, to, condition}]
  // execution
  cacheable       Boolean  @default(true)
  parallelizable  Boolean  @default(true)
  // reusable
  reusable        Boolean  @default(true) // can be used by multiple packages
  usageCount      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([ownerPackage])
  @@index([reusable])
}

// Policy Rule — "should it?" (separate from capability "can it?")
model PolicyRule {
  id              String   @id @default(uuid())
  policyId        String   @unique // "require-human-review-before-alert" | "budget-limit"
  name            String
  description     String
  ownerPackage    String?  // null = platform-level policy
  // declarative policy
  action          String   // "allow" | "deny" | "require"
  target          String   // "mission:create" | "alert:publish" | "observation:emit"
  condition       String   @default("{}") // JSON: {confidence: ">0.8", budget: ">100", season: "!=rainy"}
  // scope
  scope           String   @default("global") // "global" | "package:illegal-mining" | "region:ashanti"
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([target])
  @@index([scope])
  @@index([enabled])
}

// AI Provider — abstraction for LLM/AI model access
model AIProvider {
  id              String   @id @default(uuid())
  providerId      String   @unique // "openai" | "gemini" | "claude" | "local"
  name            String
  // capabilities
  supportsReason Boolean  @default(true)
  supportsExtract Boolean  @default(true)
  supportsClassify Boolean @default(true)
  supportsEmbed   Boolean  @default(true)
  supportsChat    Boolean  @default(true)
  // status
  status          String   @default("available") // available | active | degraded | unavailable
  apiEndpoint     String?
  model           String?
  // config
  config          String   @default("{}") // JSON: apiKey ref, maxTokens, temperature
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// Scheduled Job — agents become schedulable jobs
model ScheduledJob {
  id              String   @id @default(uuid())
  jobId           String   @unique
  jobType         String   // "reasoning" | "planning" | "verification" | "learning" | "reporting" | "monitoring"
  ownerPackage    String?
  // schedule
  schedule        String   @default("on-demand") // cron expression or "on-demand" | "event-triggered"
  triggerEvent    String?  // which event triggers this job
  // execution
  status          String   @default("pending") // pending | running | completed | failed | cancelled
  priority        Int      @default(0)
  // input/output
  inputArtifact   String?  // artifact ID to process
  outputArtifact  String?  // artifact ID produced
  // timing
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  // result
  result          String?  // "success" | "partial" | "failure"
  error           String?
  createdAt       DateTime @default(now())

  @@index([jobType])
  @@index([status])
  @@index([ownerPackage])
}

// Event Subscription — declarative event subscriptions by packages
model EventSubscription {
  id              String   @id @default(uuid())
  packageId       String   // which package subscribes
  eventType       String   // "ObservationCreated" | "EvidenceAdded" | "GroundTruthReceived" | etc.
  handler         String   // what to do: "run_workflow:review" | "emit_alert" | "create_mission"
  filter          String   @default("{}") // JSON: filter conditions
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([packageId])
  @@index([eventType])
  @@index([enabled])
}

// ===== Developer Platform: Unified Packages, Solutions, Governance, Contracts, Knowledge =====

// Solution Definition — immutable, versioned deployment specs
model SolutionDefinition {
  id              String   @id @default(uuid())
  solutionId      String   @unique // "ghana-illegal-mining"
  version         String   @default("1.0.0") // semver — immutable per version
  name            String
  description     String
  // packages with pinned versions
  packages        String   @default("[]") // JSON: [{packageId, version, required}]
  // configuration (immutable per version)
  configuration   String   @default("{}") // JSON: {country, alertThreshold, missionBudget, ...}
  // reproducibility
  contentHash     String?  // hash of packages+config for integrity verification
  createdBy       String
  createdAt       DateTime @default(now())
  // status
  status          String   @default("draft") // draft | published | archived

  @@index([solutionId])
  @@index([status])
}

// Governance Approval — who approved this package/solution (separate from policy)
model GovernanceApproval {
  id              String   @id @default(uuid())
  targetType      String   // "package" | "solution" | "policy"
  targetId        String   // packageId or solutionId
  // approver
  approverOrg     String   // "Ghana EPA" | "NADMO" | "Forestry Commission"
  approverRole    String   // "regulator" | "domain_expert" | "security_reviewer"
  approverId      String?
  // decision
  decision        String   // "approved" | "rejected" | "conditional" | "pending"
  conditions      String   @default("[]") // JSON: conditions for conditional approval
  notes           String?
  // validity
  validFrom       DateTime?
  validUntil      DateTime?
  createdAt       DateTime @default(now())

  @@index([targetType, targetId])
  @@index([approverOrg])
  @@index([decision])
}

// Feature Contract — typed feature declarations for loose coupling
model FeatureContract {
  id              String   @id @default(uuid())
  featureId       String   @unique // "ndvi" | "sar_backscatter" | "rainfall_7d"
  providerPackage String   // which package provides this feature
  // type definition
  dataType        String   // "float" | "int" | "boolean" | "string" | "geometry" | "image"
  units           String?  // "ratio" | "dB" | "mm" | "degrees"
  range           String?  // JSON: [min, max]
  // versioning
  version         String   @default("1.0.0")
  // consumers
  consumers       String   @default("[]") // JSON: package IDs that require this feature
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerPackage])
  @@index([dataType])
}

// Knowledge Package — domain knowledge without executable code
model KnowledgePackage {
  id              String   @id @default(uuid())
  packageId       String   @unique // "ghana-mining-knowledge"
  name            String
  version         String
  description     String
  author          String
  // knowledge contents (JSON blobs)
  ontology        String   @default("{}") // JSON: concepts, relationships
  causalGraph     String   @default("{}") // JSON: cause→effect edges
  taxonomies      String   @default("{}") // JSON: classification hierarchies
  confidencePriors String  @default("{}") // JSON: base-rate priors
  scientificRefs  String   @default("[]") // JSON: [{title, authors, url, doi}]
  terminology     String   @default("{}") // JSON: term→definition
  mappings        String   @default("{}") // JSON: cross-domain concept mappings
  // no executable code — pure knowledge
  hasCode         Boolean  @default(false)
  // status
  status          String   @default("available")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// Agent Package — standardized agent definition
model AgentPackage {
  id              String   @id @default(uuid())
  agentId         String   @unique // "mining-analyst" | "flood-coordinator"
  packageId       String   // parent package
  name            String
  description     String
  // agent behavior
  role            String   // "reasoning" | "planning" | "verification" | "learning" | "reporting" | "monitoring"
  // subscriptions (what events trigger this agent)
  subscribes      String   @default("[]") // JSON: ["ObservationCreated", "GroundTruthReceived"]
  // jobs (what this agent runs)
  jobs            String   @default("[]") // JSON: ["reasoning", "planning"]
  // permissions (capabilities needed)
  permissions     String   @default("[]") // JSON: ["hypothesis:create", "mission:create"]
  // model preferences
  preferredAI     String?  // "openai" | "gemini" | "claude" | null (platform default)
  // status
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([packageId])
  @@index([role])
  @@index([enabled])
}

// Package Lifecycle State — formal trust pipeline
// Draft → Built → Validated → Signed → Verified → Official → (Deprecated → Archived)
model PackageLifecycle {
  id              String   @id @default(uuid())
  packageId       String   @unique
  currentState    String   @default("draft") // draft | built | validated | signed | verified | official | deprecated | archived
  // transition history
  history         String   @default("[]") // JSON: [{from, to, by, at, notes}]
  // checks
  buildVerified   Boolean  @default(false)
  testsPassed     Boolean  @default(false)
  contractsValid  Boolean  @default(false)
  signatureHash   String?
  signatureVerified Boolean @default(false)
  reviewedBy      String?  // org that reviewed
  reviewDate      DateTime?
  // timestamps
  lastTransitionAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([currentState])
}

// Developer CLI command log — tracks package development operations
model DevCommand {
  id              String   @id @default(uuid())
  command         String   // "create" | "build" | "test" | "sign" | "publish" | "install" | "upgrade"
  packageId       String?
  // result
  status          String   // "success" | "failed"
  output          String   @default("{}") // JSON: command output
  durationMs      Int?
  executedBy      String?
  createdAt       DateTime @default(now())

  @@index([command])
  @@index([packageId])
  @@index([status])
}

// ===== Capability Negotiation & Unified Package Model =====
// Everything is a Package. Packages provide/require capabilities.
// The runtime negotiates: "I require any provider of weather.precipitation"
// not "I require weather-connector". This makes packages portable across deployments.

// Provider Capability — what a package provides (declared, not hardcoded)
model ProviderCapability {
  id              String   @id @default(uuid())
  packageId       String   // which package provides this
  capability      String   // "weather.precipitation.daily" | "optical.imagery.sentinel2" | "reasoning.bayesian"
  capabilityType  String   // "dataset" | "feature" | "reasoning" | "mission" | "knowledge" | "ui" | "workflow" | "agent" | "ai_provider"
  // versioning
  version         String   @default("1.0.0")
  // quality/cost metadata
  quality         Float    @default(0.8) // 0..1
  cost            Float    @default(0) // relative cost
  latency         String?  // "real-time" | "near-real-time" | "batch"
  // contract (what format/type this capability produces)
  outputType      String?  // "Observation" | "Feature" | "Hypothesis" | "RasterProduct"
  outputSchema    String   @default("{}") // JSON schema of output
  createdAt       DateTime @default(now())

  @@unique([packageId, capability])
  @@index([capability])
  @@index([capabilityType])
}

// Package Dependency — DAG-based dependency graph with capability negotiation
model PackageDependency {
  id              String   @id @default(uuid())
  packageId       String   // the dependent (consumer)
  // what it needs (either specific package OR any provider of a capability)
  dependencyType  String   // "package" | "capability" // specific package or any provider
  targetId        String   // packageId (if type=package) OR capability string (if type=capability)
  versionRange    String   @default("*") // semver range
  required        Boolean  @default(true) // hard vs optional dependency
  // negotiation preferences
  preferredQuality Float   @default(0.8) // minimum quality threshold
  maxCost         Float?   // maximum acceptable cost
  // resolution status
  resolved        Boolean  @default(false)
  resolvedPackage String?  // which package was selected to satisfy this dependency
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([packageId])
  @@index([dependencyType, targetId])
  @@index([resolved])
}

// Unified Package Manifest — extends PlatformPackage with provides/requires/exports
model PackageManifest {
  id              String   @id @default(uuid())
  packageId       String   @unique
  // provides (capabilities this package exposes)
  provides        String   @default("[]") // JSON: [{capability, type, version, quality, cost, outputType}]
  // requires (dependencies — either specific packages or capability negotiations)
  requires        String   @default("[]") // JSON: [{type: "package"|"capability", target, versionRange, required, preferredQuality, maxCost}]
  // exports (what this package produces for other packages to consume)
  exports         String   @default("{}") // JSON: {observations: [...], hypotheses: [...], missions: [...], features: [...], alerts: [...]}
  // permissions (capabilities needed from the kernel)
  permissions     String   @default("[]") // JSON: ["raster.read", "mission.create", "alert.publish"]
  // composition
  composes        String   @default("[]") // JSON: package IDs this composes from
  // negotiation preferences
  portable        Boolean  @default(true) // can this package be deployed with alternative providers?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([portable])
}

// ===== Kernel v1.0: Final Refinements =====
// Typed capability contracts, semantic matching, immutable artifacts,
// provider provenance, execution plans. After this, the kernel is FROZEN.

// Typed Capability Contract — capabilities are API contracts, not just strings
model TypedCapabilityContract {
  id              String   @id @default(uuid())
  capabilityId    String   @unique // "weather.precipitation.daily"
  version         String   @default("1.0.0") // semver
  // input/output schema (JSON Schema-like)
  inputSchema     String   @default("{}") // JSON: {geometry: Polygon, start: Date, end: Date}
  outputSchema    String   @default("{}") // JSON: {rainfall_mm: float, confidence: float, provenance: DatasetReference}
  // quality of service
  qosLatency      String?  // "<5s"
  qosFreshness    String?  // "<24h"
  qosAvailability Float?   // 0..1
  // backward compatibility
  compatibleWith  String   @default("[]") // JSON: ["v1", "v2"]
  // semantic metadata (for ontology matching)
  semanticCategory String? // "precipitation" | "optical_imagery" | "elevation" | "reasoning"
  semanticTags    String   @default("[]") // JSON: ["rainfall", "daily", "gridded"]
  description     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([semanticCategory])
}

// Immutable Artifact — Git-like DAG. Artifacts never change. New version = new artifact with parent.
model ImmutableArtifact {
  id              String   @id @default(uuid())
  artifactHash    String   @unique // content hash (like Git SHA)
  kind            String   // "observation" | "evidence" | "hypothesis" | "mission" | "scenario" | "report"
  // content (immutable)
  content         String   @default("{}") // JSON: the actual artifact data
  contentHash     String   // hash of content
  // lineage (DAG — parent artifacts this was derived from)
  parentHashes    String   @default("[]") // JSON: [hash1, hash2] — like Git parents
  // provenance
  createdBy       String   // "system" | "package:illegal-mining" | "user:inspector"
  createdVia      String   // "pipeline" | "negotiation" | "human_review" | "learning"
  // capability provenance (which provider was used)
  providerUsed    String?  // which package provided the data for this artifact
  providerReason  String?  // why this provider was selected
  // temporal
  createdAt       DateTime @default(now())

  @@index([kind])
  @@index([createdBy])
  @@index([createdAt])
}

// Provider Provenance — records WHY a specific provider was selected during negotiation
model ProviderProvenance {
  id              String   @id @default(uuid())
  capability      String   // "weather.precipitation.daily"
  // candidates considered
  candidates      String   @default("[]") // JSON: [{packageId, quality, cost, latency, freshness}]
  // decision
  selectedPackage String   // "chirps-connector"
  selectionReason String   // "highest quality (0.95), freshness <24h, cost $0"
  // selection criteria
  criteria        String   @default("{}") // JSON: {preferredQuality, maxCost, requiredFreshness}
  // scoring
  scores          String   @default("{}") // JSON: {chirps: {quality: 0.95, cost: 0, total: 0.95}, era5: {...}}
  // temporal
  resolvedAt      DateTime @default(now())

  @@index([capability])
  @@index([selectedPackage])
}

// Execution Plan — compiled solution ready for execution
model ExecutionPlan {
  id              String   @id @default(uuid())
  planId          String   @unique
  solutionId      String?  // which solution this plan was compiled from
  // compiled DAG
  nodes           String   @default("[]") // JSON: [{packageId, capability, depth, inputs, outputs}]
  edges           String   @default("[]") // JSON: [{from, to, type}]
  executionOrder  String   @default("[]") // JSON: topological sort
  parallelGroups  String   @default("[]") // JSON: [[group1], [group2]]
  // provider assignments
  providerAssignments String @default("{}") // JSON: {capability: selectedPackage}
  // policy validation
  policyValidated Boolean  @default(false)
  policyResults   String   @default("{}") // JSON: {target: {allowed, reasons}}
  // cost estimation
  estimatedCost   Float    @default(0)
  estimatedDuration String? // "5m" | "30s"
  // status
  status          String   @default("compiled") // compiled | validated | executing | completed | failed
  startedAt       DateTime?
  completedAt     DateTime?
  // provenance
  provenance      String   @default("[]") // JSON: provider provenance records
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([solutionId])
}

// Semantic Ontology — maps capability categories to semantic concepts
model SemanticOntology {
  id              String   @id @default(uuid())
  conceptId       String   @unique // "precipitation" | "optical_imagery" | "elevation"
  label           String
  category        String   // "atmospheric" | "surface" | "subsurface" | "reasoning" | "infrastructure"
  // synonyms (for matching)
  aliases         String   @default("[]") // JSON: ["rainfall", "rain", "precip"]
  // related concepts
  broader         String?  // "atmospheric_water"
  narrower        String   @default("[]") // JSON: ["daily_precipitation", "hourly_precipitation"]
  related         String   @default("[]") // JSON: ["humidity", "soil_moisture"]
  description     String
  createdAt       DateTime @default(now())

  @@index([category])
}

// Kernel Version — tracks kernel API version for compatibility
model KernelVersion {
  id              String   @id @default(uuid())
  version         String   @unique // "1.0.0"
  // what's frozen
  frozenApis      String   @default("[]") // JSON: ["PackageManifest", "CapabilityContract", "Artifact", "EventBus", "SDK", "PolicyEngine", "Governance", "ContributionRegistry", "FeatureContracts"]
  // release notes
  releaseNotes    String
  // status
  status          String   @default("stable") // stable | beta | deprecated
  releasedAt      DateTime @default(now())

  @@index([status])
}

// ===== Platform Specification: Conformance, Capability Levels, Remote Registry =====

// Conformance Test — standard platform test suite
model ConformanceTest {
  id              String   @id @default(uuid())
  testId          String   @unique // "manifest-validation" | "capability-negotiation" | "sandbox-enforcement"
  name            String
  description     String
  category        String   // "manifest" | "negotiation" | "dependency" | "sandbox" | "quota" | "replay" | "artifact" | "policy" | "provenance"
  // test definition
  inputSchema     String   @default("{}") // JSON: what the test provides
  expectedOutput  String   @default("{}") // JSON: what the test expects
  // conformance level required
  minLevel        String   @default("verified") // "experimental" | "verified" | "certified" | "official"
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([minLevel])
}

// Conformance Result — test execution per package
model ConformanceResult {
  id              String   @id @default(uuid())
  packageId       String
  testId          String
  // result
  passed          Boolean
  output          String   @default("{}") // JSON: actual output
  diff            String?  // JSON: differences from expected
  durationMs      Int?
  // environment
  kernelVersion   String   @default("1.0.0")
  testedAt        DateTime @default(now())

  @@unique([packageId, testId])
  @@index([packageId])
  @@index([passed])
}

// Package Capability Level — maturity tier
model PackageCapabilityLevel {
  id              String   @id @default(uuid())
  packageId       String   @unique
  level           String   @default("experimental") // "experimental" | "verified" | "certified" | "official"
  // how it earned this level
  conformancePassed Int    @default(0) // number of conformance tests passed
  conformanceTotal  Int    @default(0)
  governanceApproved Boolean @default(false)
  // certification
  certifiedBy     String?  // "Ghana EPA" | "University of Ghana"
  certifiedAt     DateTime?
  certificateUrl  String?
  // badge
  badgeColor      String   @default("#71717a")
  updatedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([level])
}

// Remote Package Registry — for distributed package distribution
model RemoteRegistry {
  id              String   @id @default(uuid())
  registryId      String   @unique // "official" | "epa-ghana" | "university-ghana" | "community"
  name            String
  url             String   // "https://registry.gdt.gh" | "https://epa.gov.gh/packages"
  // trust
  trustLevel      String   @default("community") // "official" | "verified" | "community"
  isDefault       Boolean  @default(false)
  // auth
  requiresAuth    Boolean  @default(false)
  authType        String?  // "bearer" | "basic" | "api-key"
  // stats
  packageCount    Int      @default(0)
  lastSyncAt      DateTime?
  status          String   @default("available") // available | syncing | degraded | unavailable
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([trustLevel])
  @@index([status])
}

// Remote Package — cached package from a remote registry
model RemotePackage {
  id              String   @id @default(uuid())
  packageId       String   // "illegal-mining"
  version         String   // "2.3.1"
  registryId      String   // which registry hosts this
  // metadata
  name            String
  description     String
  author          String
  kind            String
  // download
  downloadUrl     String
  contentHash     String?  // for verification
  signatureHash   String?  // for signing verification
  sizeBytes       Int?
  // cache status
  cached          Boolean  @default(false)
  cachedAt        DateTime?
  cachePath       String?
  // verification
  signatureVerified Boolean @default(false)
  contractsValidated Boolean @default(false)
  // status
  status          String   @default("available") // available | downloading | cached | verified | activated | failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([packageId, version, registryId])
  @@index([registryId])
  @@index([status])
}

// SDK Interface Freeze — tracks which SDK methods are frozen
model SDKInterfaceFreeze {
  id              String   @id @default(uuid())
  interfaceId     String   @unique // "ctx.v1.world.query" | "ctx.v1.features.read"
  apiVersion      String   @default("v1")
  methodSignature String   // "(opts: QueryOptions) => Promise<Entity[]>"
  description     String
  frozenAt        DateTime @default(now())
  // compatibility
  deprecatedIn    String?  // version where deprecated (null = not deprecated)
  replacedBy      String?  // new interface name if replaced
  createdAt       DateTime @default(now())

  @@index([apiVersion])
}

// ===== Milestone 7: Autonomous Runtime (Package-level, NOT kernel) =====
// Agents are packages. They execute on the frozen kernel via events,
// SDK, artifacts, and execution plans. No kernel modifications.

// Agent Run — execution instance of an agent
model AgentRun {
  id              String   @id @default(uuid())
  runId           String   @unique
  agentId         String   // which agent package executed
  // trigger
  triggerEvent    String?  // "ObservationCreated" | "GroundTruthReceived" | etc.
  triggerArtifact String?  // artifact hash that triggered this run
  // context assembled
  contextArtifacts String  @default("[]") // JSON: artifact hashes the agent read
  // reasoning
  reasoningSummary String? // human-readable reasoning chain
  reasoningSteps  String   @default("[]") // JSON: [{step, input, output, confidence}]
  // proposed actions
  proposedActions String   @default("[]") // JSON: [{type, target, params, cost, infoGain}]
  // policy check
  policyChecked   Boolean  @default(false)
  policyAllowed   Boolean  @default(false)
  policyReasons   String   @default("[]") // JSON: reasons from policy evaluation
  // execution
  executionPlanId String?  // FK to ExecutionPlan if actions were compiled
  executedActions String   @default("[]") // JSON: actions actually executed
  // output
  outputArtifacts String   @default("[]") // JSON: artifact hashes produced
  eventsEmitted   String   @default("[]") // JSON: events emitted
  // status
  status          String   @default("pending") // pending | reasoning | planning | executing | completed | failed
  // evaluation
  accuracyScore   Float?
  costEfficiency  Float?
  humanAccepted   Boolean?
  // timing
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  // cost
  actualCost      Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([status])
  @@index([triggerEvent])
  @@index([createdAt])
}

// Agent Memory Artifact — memory stored as immutable artifacts (not separate DB)
model AgentMemoryArtifact {
  id              String   @id @default(uuid())
  artifactHash    String   @unique // FK to ImmutableArtifact.hash
  agentId         String   // which agent owns this memory
  // memory type
  memoryType      String   // "observation_learned" | "decision" | "mistake" | "success_pattern" | "context"
  // content reference
  contentHash     String   // hash of the memory content
  // links
  relatedArtifacts String  @default("[]") // JSON: artifact hashes this memory relates to
  // temporal
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([memoryType])
  @@index([artifactHash])
}

// Agent Evaluation — performance scores per agent
model AgentEvaluation {
  id              String   @id @default(uuid())
  agentId         String   @unique
  // accuracy metrics
  accuracyScore   Float    @default(0.5) // 0..1
  falsePositiveRate Float  @default(0)
  falseNegativeRate Float  @default(0)
  // calibration
  calibrationScore Float   @default(0.5) // 0..1 (1 = perfectly calibrated)
  brierScore      Float    @default(0.25)
  // cost
  avgCostPerRun   Float    @default(0)
  avgVerificationCost Float @default(0)
  totalRuns       Int      @default(0)
  totalCost       Float    @default(0)
  // human acceptance
  humanAcceptanceRate Float @default(0) // 0..1
  confirmedCount  Int      @default(0)
  rejectedCount   Int      @default(0)
  // trust
  trustLevel      String   @default("experimental") // experimental | verified | certified | official
  trustScore      Float    @default(0.5)
  // temporal
  lastEvaluatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([trustLevel])
}

// Agent Action — individual action proposed/executed by an agent
model AgentAction {
  id              String   @id @default(uuid())
  runId           String   // FK to AgentRun
  // action
  actionType      String   // "query_world" | "read_features" | "ai_reason" | "create_mission" | "publish_alert" | "emit_observation"
  target          String?  // what the action targets (entity ID, tile ID, etc.)
  params          String   @default("{}") // JSON
  // status
  status          String   @default("proposed") // proposed | approved | executed | rejected | failed
  // result
  resultArtifact  String?  // artifact hash produced
  resultSummary   String?
  // cost
  estimatedCost   Float    @default(0)
  actualCost      Float    @default(0)
  // policy
  policyChecked   Boolean  @default(false)
  policyAllowed   Boolean  @default(false)
  executedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([runId])
  @@index([actionType])
  @@index([status])
}

// ===== Milestone 7.5: Intelligence Governance & Agent Economy =====
// Agent reputation, multi-agent debate, arbitration, communication, safety boundaries.
// ALL package-level. NO kernel modifications.

// Agent Reputation — performance-based trust scoring
model AgentReputation {
  id              String   @id @default(uuid())
  agentId         String   @unique
  // metrics (accumulated)
  totalPredictions Int     @default(0)
  confirmedCorrect Int     @default(0)
  falsePositives  Int      @default(0)
  falseNegatives  Int      @default(0)
  // scores (0..1)
  accuracyScore   Float    @default(0.5)
  calibrationScore Float   @default(0.5)
  costEfficiencyScore Float @default(0.5)
  responseTimeScore Float  @default(0.5)
  overallScore    Float    @default(0.5)
  // trust
  trustLevel      String   @default("experimental") // experimental | verified | certified | official
  reputationRank  Int      @default(0) // ranking among all agents
  // temporal
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([trustLevel])
  @@index([overallScore])
  @@index([reputationRank])
}

// Agent Debate — multi-agent debate session
model AgentDebate {
  id              String   @id @default(uuid())
  debateId        String   @unique
  // topic
  observationId   String?
  hypothesisId    String?
  topic           String   // "What explains the vegetation loss at [location]?"
  // participants
  participants    String   @default("[]") // JSON: [{agentId, role, initialPosition}]
  // arguments
  arguments       String   @default("[]") // JSON: [{agentId, position, confidence, reasoning, evidence}]
  // coordinator
  coordinatorId   String?  // which agent coordinated
  // result
  finalAssessment String?  // "seasonal flooding" | "artisanal mining" | "inconclusive"
  finalConfidence Float?
  finalReasoning  String?  // JSON: reasoning chain
  consensusReached Boolean @default(false)
  // status
  status          String   @default("open") // open | debating | resolved | inconclusive
  // timing
  startedAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@index([status])
  @@index([observationId])
  @@index([startedAt])
}

// Agent Message — agent-to-agent communication protocol
model AgentMessage {
  id              String   @id @default(uuid())
  messageId       String   @unique
  fromAgent       String   // sender agent ID
  toAgent         String   // recipient agent ID (or "broadcast")
  // message
  type            String   // "request_analysis" | "share_evidence" | "challenge_hypothesis" | "support_hypothesis" | "request_verification"
  artifactRef     String?  // artifact hash being discussed
  content         String   // message content
  // response
  responseTo      String?  // messageId this responds to
  responseArtifact String? // artifact hash of response
  // status
  status          String   @default("sent") // sent | received | responded | ignored
  createdAt       DateTime @default(now())
  respondedAt     DateTime?

  @@index([fromAgent])
  @@index([toAgent])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// Intelligence Arbitration — resolve conflicts between agents
model AgentArbitration {
  id              String   @id @default(uuid())
  arbitrationId   String   @unique
  // the conflict
  debateId        String?  // FK to AgentDebate
  observationId   String?
  // conflicting claims
  claims          String   @default("[]") // JSON: [{agentId, assessment, confidence, evidence}]
  // arbitration
  arbiterAgent    String?  // which agent arbitrated
  finalAssessment String?
  finalConfidence Float?
  reasoning       String   @default("[]") // JSON: reasoning steps
  evidenceConsidered String @default("[]") // JSON: evidence artifacts considered
  // outcome
  outcome         String   @default("pending") // pending | resolved | escalated | inconclusive
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([outcome])
  @@index([debateId])
}

// Agent Safety Boundary — risk levels and action gates
model AgentSafetyBoundary {
  id              String   @id @default(uuid())
  agentId         String   @unique
  // current risk level (0-5)
  riskLevel       Int      @default(1) // 0=observe, 1=hypothesize, 2=request evidence, 3=recommend, 4=alert, 5=intervene
  // allowed actions per level
  allowedActions  String   @default("{}") // JSON: {0: ["read", "observe"], 1: ["hypothesize"], ...}
  // requires approval
  approvalRequired String  @default("[]") // JSON: actions that require human approval
  // constraints
  maxDailyRuns    Int      @default(100)
  maxDailyCost    Float    @default(50)
  maxConcurrent   Int      @default(5)
  // current usage
  runsToday       Int      @default(0)
  costToday       Float    @default(0)
  // temporal
  lastResetAt     DateTime @default(now())
  updatedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([riskLevel])
}

// Agent Evaluation Arena — competition between agents
model AgentArenaChallenge {
  id              String   @id @default(uuid())
  challengeId     String   @unique
  name            String
  description     String
  // dataset
  datasetName     String   // "ghana-mining-2019-2021"
  sampleCount     Int
  // participants
  participants    String   @default("[]") // JSON: [{agentId, results}]
  // results
  results         String   @default("[]") // JSON: [{agentId, precision, recall, f1, falseAlarm, costPerInference}]
  winner          String?  // agentId of winner
  // status
  status          String   @default("open") // open | running | completed
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([datasetName])
}

// ===========================================================================
// MILESTONE 8 — NATIONAL INTELLIGENCE COMMAND CENTER (Package Layer)
// The kernel is FROZEN. Everything below is package-level operational state.
// Intelligence → Assessment → Decision → Workflow → Action → Outcome → Learning
// ===========================================================================

// IncidentArtifact — operational incident (NOT an alert). An alert is information;
// an incident is operational and tracks a human + institutional workflow.
// Lifecycle: detected → reviewed → assigned → investigated → resolved → closed → learned
model IncidentArtifact {
  id              String   @id @default(uuid())
  incidentId      String   @unique // "GH-MIN-001"
  // classification
  type            String   // "illegal_mining" | "flood_risk" | "deforestation" | "cocoa_disease" | ...
  severity        String   // "low" | "moderate" | "high" | "critical"
  title           String
  summary         String
  // geography
  regionId        String?
  location        String   @default("{}") // JSON: {lng, lat}
  areaAffectedHa  Float?
  // intelligence provenance — links back into the intelligence chain
  evidence        String   @default("[]") // JSON: [observationId, sarSceneId, ...]
  assessmentId    String?  // arbitration/assessment artifact hash this was opened from
  confidence      Float    @default(0.5) // fused confidence from agents/arbitration
  agentsInvolved  String   @default("[]") // JSON: [agentId, ...]
  arbitrationId   String?  // AgentArbitration reference
  // operational assignment
  assignedTo      String   @default("[]") // JSON: [roleId, teamId, userId]
  workflowId      String?  // OperationalWorkflow definition
  workflowExecutionId String? // running WorkflowExecution
  // resolution
  resolution      String?  // human summary of resolution
  outcome         String?  // "confirmed" | "false_positive" | "mitigated" | "escalated" | "monitoring"
  // learning link (closed loop)
  learningFeedback String? // feedback artifact hash sent back to Learning Agent
  // lifecycle
  status          String   @default("detected")
  detectedAt      DateTime @default(now())
  reviewedAt      DateTime?
  assignedAt      DateTime?
  investigatedAt  DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  learnedAt       DateTime?
  // audit
  createdBy       String   @default("system") // "agent:mining-analyst" | "user:epa-1"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([regionId])
  @@index([detectedAt])
}

// OperationalWorkflow — human-in-the-loop workflow definitions (a package).
// Example: environmental-enforcement with conditional steps gated on confidence.
model OperationalWorkflow {
  id              String   @id @default(uuid())
  workflowId      String   @unique // "environmental-enforcement"
  name            String
  description     String
  // trigger condition (declarative)
  triggerType     String   // incident type this workflow handles
  triggerCondition String  @default("{}") // JSON: {confidence: ">0.85", severity: ["high","critical"]}
  // ordered steps
  steps           String   @default("[]") // JSON: [{id, name, type:human_review|evidence_package|assign_inspector|field_verification|resolution|notify, requiredRole, sla: "24h", condition?}]
  // governance
  owningRole      String   // role that owns the workflow
  // package provenance
  packageId       String   @default("national-command-center")
  version         String   @default("1.0.0")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([triggerType])
  @@index([active])
}

// WorkflowExecution — a running instance of a workflow bound to an incident.
// Each step records actor, decision, timestamp, artifact produced.
model WorkflowExecution {
  id              String   @id @default(uuid())
  executionId     String   @unique
  workflowId      String   // OperationalWorkflow.workflowId
  incidentId      String   // IncidentArtifact.incidentId
  // state
  currentStep     Int      @default(0)
  stepStates      String   @default("[]") // JSON: [{stepId, status: pending|active|completed|skipped|failed, actor, startedAt, completedAt, decision, artifactHash}]
  // timing
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  // status
  status          String   @default("running") // running | completed | aborted | escalated
  abortReason     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([incidentId])
  @@index([status])
}

// DecisionArtifact — every human decision becomes an immutable artifact.
// Closes the provenance gap: Assessment → Human Decision → Operational Action.
model DecisionArtifact {
  id              String   @id @default(uuid())
  decisionId      String   @unique // "DEC-2025-0001"
  // context
  incidentId      String?  // IncidentArtifact.incidentId
  workflowExecutionId String? // WorkflowExecution
  // actor & authority
  actorId         String   // "epa-user-1"
  actorRole       String   // "environmental_regulator"
  // decision
  decisionType    String   // "approve_field_inspection" | "dispatch_inspector" | "declare_alert" | "close_incident" | "escalate" | ...
  decision        String   // human-readable decision text
  rationale       String   // why
  // provenance — what intelligence this decision was based on
  basedOn         String   @default("[]") // JSON: [assessmentHash, observationId, arbitrationId, ...]
  // authority check
  permissionsUsed String   @default("[]") // JSON: [permissionId, ...] — which role permissions authorized this
  policyChecked   Boolean  @default(true)
  // outcome link
  actionIds       String   @default("[]") // JSON: [OperationalAction.actionId]
  // temporal
  decidedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([incidentId])
  @@index([actorId])
  @@index([decidedAt])
}

// InstitutionalRole — roles & permissions as a governance package.
// NOT hardcoded users. Roles are packages; users are assigned roles.
model InstitutionalRole {
  id              String   @id @default(uuid())
  roleId          String   @unique // "environmental_regulator"
  name            String
  description     String
  institution     String   // "EPA" | "NADMO" | "COCOBOD" | "Forestry Commission"
  // permissions (capability-style)
  permissions     String   @default("[]") // JSON: [{id, name, scope}]
  // safety boundaries
  maxSeverity     String   @default("critical") // highest severity this role can act on
  canEscalate     Boolean  @default(true)
  requiresApproval String  @default("[]") // JSON: [decisionType, ...] decisions that need supervisor approval
  // package provenance
  packageId       String   @default("institutional-roles")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([institution])
  @@index([active])
}

// OperationalAction — concrete field/institutional actions tied to decisions.
// dispatch_inspector, declare_alert, publish_report, coordinate_response, ...
model OperationalAction {
  id              String   @id @default(uuid())
  actionId        String   @unique // "ACT-2025-0001"
  // provenance
  incidentId      String   // IncidentArtifact.incidentId
  decisionId      String?  // DecisionArtifact.decisionId that authorized this
  // action
  actionType      String   // "dispatch_inspector" | "drone_verification" | "declare_alert" | "publish_report" | "coordinate_response" | "issue_notice" | "shut_down_operation"
  description     String
  // assignment
  assignedTo      String   // role or team
  assignedRole    String
  // execution
  status          String   @default("dispatched") // dispatched | in_progress | completed | failed | cancelled
  scheduledAt     DateTime?
  dispatchedAt    DateTime?
  completedAt     DateTime?
  // result
  result          String?  // human-readable result
  evidenceCollected String @default("[]") // JSON: [artifactHash, ...] evidence produced by this action
  cost            Float    @default(0)
  // temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([incidentId])
  @@index([status])
  @@index([actionType])
}

// OutcomeReport — the result of operational actions, feeds the learning loop.
// Outcome → Learning Agent → updated priors/calibration.
model OutcomeReport {
  id              String   @id @default(uuid())
  outcomeId       String   @unique // "OUT-2025-0001"
  incidentId      String   // IncidentArtifact.incidentId
  // outcome
  result          String   // "confirmed" | "false_positive" | "mitigated" | "escalated" | "no_action_needed"
  groundTruth     Boolean?  // was the original intelligence assessment correct?
  // details
  summary         String
  fieldFindings   String   @default("{}") // JSON: structured findings
  // costs & timing
  timeToResolveH  Float?   // hours from detection to resolution
  totalCost       Float    @default(0)
  // learning link
  feedbackSent    Boolean  @default(false)
  feedbackArtifact String? // artifact hash sent to learning agent
  // temporal
  reportedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([incidentId])
  @@index([result])
}

// EvidenceRoomEntry — the legal-style evidence file for an incident.
// Aggregates the FULL provenance chain into one queryable record.
model EvidenceRoomEntry {
  id              String   @id @default(uuid())
  incidentId      String   @unique // one evidence room per incident
  // aggregated evidence by modality
  satelliteEvidence  String @default("[]") // JSON: [{type, source, date, finding, confidence, artifactHash}]
  sarEvidence        String @default("[]")
  weatherEvidence    String @default("[]")
  historicalEvidence String @default("[]")
  agentReasoning     String @default("[]") // JSON: [{agentId, position, confidence, reasoning}]
  debateSummary      String @default("{}") // JSON: debate + arbitration result
  // assessment
  fusedConfidence    Float  @default(0.5)
  recommendedAction  String?
  // chain completeness audit
  chainSteps         String @default("[]") // JSON: [{step, present: bool, artifactHash?}]
  chainComplete      Boolean @default(false)
  // provenance
  assembledAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([incidentId])
}

// SituationEvent — live situation room event stream. Real-time operational feed.
model SituationEvent {
  id              String   @id @default(uuid())
  eventId         String   @unique
  // event
  kind            String   // "mining_anomaly" | "flood_risk" | "agent_debate" | "arbitration" | "incident_opened" | "decision_made" | "action_dispatched" | "outcome_reported" | "alert_declared"
  severity        String   @default("info") // "info" | "warn" | "crit"
  title           String
  detail          String
  regionId        String?
  // links
  incidentId      String?
  agentId         String?
  artifactHash    String?
  // temporal
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([occurredAt])
  @@index([kind])
  @@index([severity])
}

// CommandCenterPackage — the package manifest for the command center itself.
// Proves the command center is a package, not a core feature.
model CommandCenterPackage {
  id              String   @id @default(uuid())
  packageId       String   @unique // "national-command-center"
  name            String
  version         String
  // capabilities required (consumes intelligence)
  requires        String   @default("[]") // JSON: [capability:intelligence.assessment, ...]
  // capabilities provided
  provides        String   @default("[]") // JSON: [dashboard.command, workflow.operational, reporting.executive]
  // composition — sub-packages
  subPackages     String   @default("[]") // JSON: [incident-management, workflow-engine, evidence-room, institutional-roles, ...]
  // status
  active          Boolean  @default(true)
  installedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// MILESTONE 8.5 — COMMUNITY INTELLIGENCE NETWORK (Package Layer)
// The "Waze layer". Citizens become intelligence producers. The kernel is
// FROZEN. Community intelligence is another evidence channel alongside
// satellites, sensors, and agents. Citizens → Events → Witnesses → Fusion →
// Observation → Hypothesis → Incident → Command Center.
// ===========================================================================

// Citizen — pseudonymous identity with a civic reputation score.
// NOT a hardcoded user. A citizen is an intelligence producer like an agent.
model Citizen {
  id              String   @id @default(uuid())
  citizenId       String   @unique // "cit-7f3a2b"
  // pseudonymous identity (no PII at the kernel layer — identity packages handle auth)
  handle          String   @unique // "kwesi_western" (display name)
  // home region (for location relevance scoring + nearby witness routing)
  homeRegionId    String?
  homeLocation    String   @default("{}") // JSON: {lng, lat}
  // civic score (computed — see CivicScore model for breakdown)
  civicScore      Float    @default(50) // 0..100
  trustLevel      String   @default("new") // new | trusted | verified | expert
  // contribution stats (accumulated)
  totalReports    Int      @default(0)
  confirmedReports Int     @default(0)
  falseReports    Int      @default(0)
  unresolvedReports Int    @default(0)
  totalWitnessResponses Int @default(0)
  witnessAgreements Int    @default(0)
  // reward economy
  totalEarnings   Float    @default(0)
  pendingEarnings Float    @default(0)
  // anti-gaming
  flaggedForReview Boolean @default(false)
  flaggedReason   String?
  // temporal
  joinedAt        DateTime @default(now())
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([homeRegionId])
  @@index([civicScore])
  @@index([trustLevel])
}

// CitizenEvent — a citizen-reported intelligence event. Evidence is optional.
// A claim + optional evidence + witness responses = a community evidence channel.
// Lifecycle mirrors incidents: created → broadcast → witnessing → fusing →
// verified → resolved → rewarded → learned
model CitizenEvent {
  id              String   @id @default(uuid())
  eventId         String   @unique // "CE-2025-0001"
  // reporter
  citizenId       String   // Citizen.citizenId
  // classification (mirrors incident types for fusion)
  type            String   // illegal_mining | flood_risk | deforestation | water_pollution | ...
  severity        String   @default("moderate") // low | moderate | high | critical (self-declared)
  title           String
  description     String   // the claim
  // geography
  regionId        String?
  location        String   @default("{}") // JSON: {lng, lat}
  accuracyM       Float    @default(50) // reported GPS accuracy in meters
  // temporal
  occurredAt      DateTime // when the citizen says it happened
  reportedAt      DateTime @default(now()) // when they reported it
  // self-declared confidence (citizen's own certainty)
  selfConfidence  Float    @default(0.5) // 0..1
  // computed confidence (fused from claim + witnesses + evidence + civic score)
  fusedConfidence Float    @default(0)
  // witness network state
  witnessCount    Int      @default(0)
  confirmCount    Int      @default(0)
  rejectCount     Int      @default(0)
  unknownCount    Int      @default(0)
  // evidence
  hasPhoto        Boolean  @default(false)
  hasVideo        Boolean  @default(false)
  hasAudio        Boolean  @default(false)
  hasGps          Boolean  @default(false)
  textOnly        Boolean  @default(true)
  // fusion bridge — links to the intelligence layer
  fusedObservationId String? // Observation.id if fused into the intelligence layer
  fusedIncidentId String?    // IncidentArtifact.incidentId if it created an incident
  // resolution
  outcome         String?  // confirmed | false_positive | unverified | escalated
  groundTruth     Boolean?
  resolutionNote  String?
  // reward
  rewardDistributed Boolean @default(false)
  rewardPoolId    String?
  // lifecycle
  status          String   @default("created") // created | broadcast | witnessing | fusing | verified | resolved | rewarded | learned
  broadcastAt     DateTime?
  witnessingDeadline DateTime? // witnesses respond by this time
  verifiedAt      DateTime?
  resolvedAt      DateTime?
  rewardedAt      DateTime?
  learnedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([regionId])
  @@index([reportedAt])
  @@index([citizenId])
}

// CitizenEvidence — optional evidence attached to a citizen event.
// Photos, videos, audio, GPS tracks, text. Each piece is scored for quality.
model CitizenEvidence {
  id              String   @id @default(uuid())
  eventId         String   // CitizenEvent.eventId
  // evidence type
  kind            String   // photo | video | audio | gps_track | text | document
  // storage (package layer — actual media handled by connectors)
  mediaUrl        String?  // URL or reference to stored media
  caption         String?
  // metadata
  capturedAt      DateTime?
  location        String   @default("{}") // JSON: {lng, lat}
  // quality score (computed: resolution, exif, geotag, timestamp match)
  qualityScore    Float    @default(0.5) // 0..1
  // AI verification (optional — did AI verify this evidence?)
  aiVerified      Boolean  @default(false)
  aiVerification  String?  // JSON: {match, confidence, notes}
  // provenance
  contributedBy   String   // citizenId of contributor (may differ from reporter)
  createdAt       DateTime @default(now())

  @@index([eventId])
  @@index([kind])
}

// WitnessResponse — the Waze mechanism. Nearby users confirm/reject/unknown.
// Each witness response is itself evidence.
model WitnessResponse {
  id              String   @id @default(uuid())
  responseId      String   @unique
  eventId         String   // CitizenEvent.eventId
  witnessId       String   // Citizen.citizenId
  // response
  response        String   // confirm | reject | unknown
  note            String?  // witness explanation
  // witness location at time of response (for proximity scoring)
  witnessLocation String   @default("{}") // JSON: {lng, lat}
  distanceToEventM Float?  // computed distance
  // optional evidence from witness
  hasEvidence     Boolean  @default(false)
  evidenceKind    String?  // photo | video | text
  // witness's civic score at time of response (weighted into fusion)
  witnessCivicScore Float  @default(50)
  // temporal
  respondedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([eventId, witnessId]) // one response per witness per event
  @@index([eventId])
  @@index([witnessId])
  @@index([response])
}

// CivicScore — the prediction-accuracy score breakdown.
// Updated when a citizen's reports resolve. NOT a popularity score.
model CivicScore {
  id              String   @id @default(uuid())
  citizenId       String   @unique
  // overall (0..100)
  overall         Float    @default(50)
  trustLevel      String   @default("new") // new | trusted | verified | expert
  // 6 factors (each 0..1)
  accuracy        Float    @default(0.5)       // historical: confirmed / resolved
  evidenceQuality Float    @default(0.5)       // avg quality of evidence submitted
  witnessAgreement Float   @default(0.5)       // how often witnesses agree with this user
  locationRelevance Float  @default(0.5)       // relevance of reported location
  responseReliability Float @default(0.5)      // consistency/speed of witness responses
  contributionDiversity Float @default(0.5)    // spread across categories/regions
  // weights (sum to 1.0) — tunable by governance
  weights         String   @default("{\"accuracy\":0.30,\"evidenceQuality\":0.20,\"witnessAgreement\":0.20,\"locationRelevance\":0.10,\"responseReliability\":0.10,\"contributionDiversity\":0.10}")
  // history for trend
  previousOverall Float?
  trendDelta      Float?
  // temporal
  lastUpdated     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// RegionalSubscription — users subscribe to region/category/risk/verification.
// When a matching event verifies, an alert is generated.
model RegionalSubscription {
  id              String   @id @default(uuid())
  subscriptionId  String   @unique
  citizenId       String   // subscriber
  // filters
  regionId        String?  // null = all regions
  categories      String   @default("[]") // JSON: [illegal_mining, flood_risk, ...] — empty = all
  minSeverity     String   @default("moderate") // low | moderate | high | critical
  verifiedOnly    Boolean  @default(true) // only alert on verified events
  minConfidence   Float    @default(0.7)
  // delivery
  alertCount      Int      @default(0)
  lastAlertAt     DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([citizenId])
  @@index([regionId])
  @@index([active])
}

// RewardPool — bounty pool for a category/region. Created by gov/corp/platform.
model RewardPool {
  id              String   @id @default(uuid())
  poolId          String   @unique
  name            String
  description     String
  // funder
  funder          String   // "government" | "corporate" | "platform" | "ngo"
  funderName      String   // "EPA Ghana" | "GalamseyFree Alliance"
  // bounty
  amountPerEvent  Float    // reward per confirmed event
  currency        String   @default("USD")
  totalBudget     Float
  distributedTotal Float   @default(0)
  // scope
  category        String   // illegal_mining | flood_risk | ...
  regionId        String?  // null = nationwide
  // distribution split (must sum to 1.0)
  splitReporter   Float    @default(0.40)
  splitWitnesses  Float    @default(0.30)
  splitEvidence   Float    @default(0.20)
  splitPlatform   Float    @default(0.10)
  // status
  active          Boolean  @default(true)
  fundedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([regionId])
  @@index([active])
}

// RewardDistribution — how a reward was split for a confirmed event.
model RewardDistribution {
  id              String   @id @default(uuid())
  distributionId  String   @unique
  eventId         String   // CitizenEvent.eventId
  poolId          String   // RewardPool.poolId
  totalAmount     Float
  // splits
  reporterAmount  Float
  witnessesAmount Float
  evidenceAmount  Float
  platformAmount  Float
  // per-recipient breakdown (JSON for flexibility)
  recipientBreakdown String @default("{}") // JSON: {citizenId: amount}
  // recipient count
  reporterId      String
  witnessIds      String   @default("[]") // JSON
  evidenceContributorIds String @default("[]") // JSON
  // temporal
  distributedAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([eventId])
  @@index([poolId])
}

// IntelligenceProducer — unifies agent/citizen/sensor/org reputation.
// The AI Reputation Graph: every intelligence producer has a common schema.
// Provenance type: "agent" | "citizen" | "sensor" | "organization" | "researcher"
model IntelligenceProducer {
  id              String   @id @default(uuid())
  producerId      String   @unique // agentId | citizenId | sensorId | orgId
  producerType    String   // agent | citizen | sensor | organization | researcher
  name            String   // display name
  // unified reputation (0..1)
  reputationScore Float    @default(0.5)
  trustLevel      String   @default("new") // new | trusted | verified | certified | official
  // contribution stats
  totalContributions Int   @default(0)
  confirmedContributions Int @default(0)
  falseContributions Int   @default(0)
  // link back to source
  sourceRef       String   // table or external reference
  // ranking
  rankByType      Int      @default(0)
  rankOverall     Int      @default(0)
  // temporal
  lastActiveAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([producerType])
  @@index([reputationScore])
  @@index([trustLevel])
}

// CommunityPackage — the package manifests for community intelligence.
model CommunityPackage {
  id              String   @id @default(uuid())
  packageId       String   @unique
  name            String
  version         String
  // capabilities provided
  provides        String   @default("[]") // JSON
  requires        String   @default("[]") // JSON
  // composition
  subPackages     String   @default("[]") // JSON
  active          Boolean  @default(true)
  installedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// MILESTONE 8.6 — CIVIC TRUST GRAPH (Package Layer)
// Moves from "User → Score" to a connected trust graph. Trust propagates from
// verified reality (confirmed outcomes) back through witnesses to reporters.
// Includes Sybil resistance (anti-gaming) now that rewards exist, and identity
// verification + vouching. The kernel is FROZEN. All package-layer.
// ===========================================================================

// TrustNode — any entity in the trust graph.
model TrustNode {
  id              String   @id @default(uuid())
  nodeId          String   @unique
  nodeType        String   // citizen | event | evidence | outcome | sensor | agent | organization | verification
  label           String
  trustScore      Float    @default(0.5)
  baseTrust       Float    @default(0.5)
  inDegree        Int      @default(0)
  outDegree       Int      @default(0)
  pagerank        Float    @default(0)
  sourceRef       String
  lastPropagationAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nodeType])
  @@index([trustScore])
  @@index([pagerank])
}

// TrustEdge — typed relationship between trust nodes.
model TrustEdge {
  id              String   @id @default(uuid())
  sourceNodeId    String
  targetNodeId    String
  edgeType        String   // reported | witnessed | confirmed_by | contradicted_by | verified_by | vouched_for | contributed_evidence | produced
  weight          Float    @default(1.0)
  sourceArtifact  String?
  createdAt       DateTime @default(now())

  @@unique([sourceNodeId, targetNodeId, edgeType])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([edgeType])
}

// TrustScore — propagated trust per citizen (graph-based, separate from CivicScore).
model TrustScore {
  id              String   @id @default(uuid())
  citizenId       String   @unique
  propagatedTrust Float    @default(50)
  graphCentrality Float    @default(0.5)
  realityConnection Float  @default(0.5)
  vouchingScore   Float    @default(0.5)
  sybilResistance Float    @default(0.5)
  trustTier       String   @default("unproven") // unproven | emerging | trusted | anchor
  previousTrust   Float?
  trendDelta      Float?
  lastPropagationAt DateTime?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// IdentityVerification — verification tiers for Sybil resistance.
model IdentityVerification {
  id              String   @id @default(uuid())
  citizenId       String   @unique
  phoneVerified   Boolean  @default(false)
  phoneVerifiedAt DateTime?
  nationalIdVerified Boolean @default(false)
  nationalIdVerifiedAt DateTime?
  biometricVerified Boolean @default(false)
  biometricVerifiedAt DateTime?
  vouchCount      Int      @default(0)
  vouchThreshold  Int      @default(3)
  vouchVerified   Boolean  @default(false)
  vouchVerifiedAt DateTime?
  verificationLevel String @default("anonymous") // anonymous | phone | national | biometric | vouched | anchor
  trustSeedBonus  Float    @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// VouchRelationship — citizen A vouches for citizen B (staked web of trust).
model VouchRelationship {
  id              String   @id @default(uuid())
  voucherId       String
  vouchedForId    String
  stake           Float    @default(0.1)
  relationship    String   @default("knows")
  note            String?
  status          String   @default("active") // active | revoked | penalized
  revokedAt       DateTime?
  revokeReason    String?
  vouchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([voucherId, vouchedForId])
  @@index([voucherId])
  @@index([vouchedForId])
}

// SybilFlag — suspected fake/gaming behavior.
model SybilFlag {
  id              String   @id @default(uuid())
  flagId          String   @unique
  citizenId       String
  flagType        String   // coordinated_witnessing | burst_reporting | location_clustering | identity_reuse | low_diversity | unusual_pattern | manual
  severity        String   @default("warn") // info | warn | critical | blocked
  description     String
  detectedPattern String   @default("{}")
  autoDetected    Boolean  @default(true)
  detectedBy      String   @default("sybil-engine")
  status          String   @default("open") // open | confirmed | dismissed | resolved
  resolvedBy      String?
  resolutionNote  String?
  resolvedAt      DateTime?
  trustPenalty    Float    @default(0)
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([citizenId])
  @@index([flagType])
  @@index([status])
  @@index([severity])
}

// BehaviorProfile — per-citizen behavior patterns for anomaly detection.
model BehaviorProfile {
  id              String   @id @default(uuid())
  citizenId       String   @unique
  avgReportsPerDay Float   @default(0)
  maxReportsPerHour Int    @default(0)
  avgTimeBetweenReportsH Float @default(0)
  uniqueLocations  Int     @default(0)
  locationClusteringScore Float @default(0)
  avgWitnessResponseTimeM Float @default(0)
  witnessAgreementRate Float @default(0.5)
  coordinatedWitnessCount Int @default(0)
  uniqueCategories Int     @default(0)
  uniqueRegions    Int     @default(0)
  sybilRiskScore  Float    @default(0)
  lastAnalyzedAt  DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// TrustPropagationRun — audit record of a propagation pass.
model TrustPropagationRun {
  id              String   @id @default(uuid())
  runId           String   @unique
  algorithm       String   @default("weighted_pagerank")
  iterations      Int      @default(20)
  dampingFactor   Float    @default(0.85)
  nodesProcessed  Int      @default(0)
  edgesProcessed  Int      @default(0)
  convergenceDelta Float   @default(0)
  seedNodeCount   Int      @default(0)
  avgTrustBefore  Float    @default(0)
  avgTrustAfter   Float    @default(0)
  maxTrustChange  Float    @default(0)
  citizensUpdated Int      @default(0)
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?
  createdAt       DateTime @default(now())
}

// CivicTrustPackage — package manifest for the civic trust graph.
model CivicTrustPackage {
  id              String   @id @default(uuid())
  packageId       String   @unique
  name            String
  version         String
  provides        String   @default("[]")
  requires        String   @default("[]")
  subPackages     String   @default("[]")
  active          Boolean  @default(true)
  installedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// MILESTONE 9 — INTELLIGENCE MARKETPLACE & VALUE ECONOMY (Package Layer)
// Turns the platform into a marketplace where intelligence producers (citizens,
// agents, sensors, organizations) publish tradable intelligence assets, consumers
// (gov, corps, NGOs) post requests/bounties, and value is exchanged with
// automated multi-source attribution. The kernel is FROZEN. All package-layer.
// ===========================================================================

// IntelligenceRequest — demand layer. Organizations post what intelligence they need.
model IntelligenceRequest {
  id              String   @id @default(uuid())
  requestId       String   @unique // "REQ-2026-0001"
  // requester
  requesterId     String   // organization or citizen ID
  requesterName   String   // "EPA Ghana"
  requesterType   String   // government | corporate | ngo | platform | citizen
  // what they need
  title           String
  description     String
  category        String   // environmental_violation | flood_risk | deforestation | crop_damage | ...
  geography       String   // "western_region" | "nationwide" | bbox
  timeframe       String   // "last_30_days" | "ongoing" | "2026-Q1"
  minConfidence   Float    @default(0.7)
  evidenceRequired String  @default("[]") // JSON: ["satellite", "witness", "field"]
  // budget
  budget          Float    @default(0)
  currency        String   @default("USD")
  pricePerAsset   Float    @default(0) // max they'll pay per matching asset
  // matching
  matchCount      Int      @default(0)
  fulfilledCount  Int      @default(0)
  // status
  status          String   @default("open") // open | matched | fulfilled | closed | expired
  deadline        DateTime?
  closedAt        DateTime?
  // temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([requesterType])
}

// IntelligenceAsset — supply layer. Producers publish tradable intelligence.
model IntelligenceAsset {
  id              String   @id @default(uuid())
  assetId         String   @unique // "IA-2026-0001"
  // producer
  producerId      String   // citizenId | agentId | sensorId | orgId
  producerType    String   // citizen | agent | sensor | organization
  producerName    String
  // the intelligence
  title           String
  description     String
  category        String   // environmental_violation | flood_risk | ...
  geography       String
  // quality (Intelligence Quality Score — the marketplace ranking metric)
  confidence      Float    @default(0.5)
  trustScore      Float    @default(0.5) // from TrustGraph
  evidenceQuality Float    @default(0.5)
  freshnessHours  Float    @default(24) // how old is the intelligence
  iqs             Float    @default(0.5) // Intelligence Quality Score (computed)
  // pricing
  price           Float    @default(0) // 0 = free
  currency        String   @default("USD")
  pricingModel    String   @default("one_time") // one_time | subscription | per_use
  // links to source intelligence
  sourceType      String   // citizen_event | agent_output | observation | satellite_scene | sensor_reading
  sourceRef       String   // ID of the source
  // marketplace stats
  viewCount       Int      @default(0)
  purchaseCount   Int      @default(0)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  // status
  status          String   @default("listed") // listed | sold | delisted | expired
  // temporal
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([iqs])
  @@index([producerType])
}

// IntelligenceMatch — exchange: a request matched to an asset.
model IntelligenceMatch {
  id              String   @id @default(uuid())
  matchId         String   @unique
  requestId       String   // IntelligenceRequest.requestId
  assetId         String   // IntelligenceAsset.assetId
  // match quality
  matchScore      Float    @default(0) // 0..1 how well asset fits request
  matchReasons    String   @default("[]") // JSON: ["category_match", "geo_match", "confidence_ok"]
  // status
  status          String   @default("proposed") // proposed | accepted | rejected | purchased
  proposedAt      DateTime @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@unique([requestId, assetId])
  @@index([requestId])
  @@index([assetId])
  @@index([status])
}

// IntelligenceTransaction — a purchase/fulfillment in the marketplace.
model IntelligenceTransaction {
  id              String   @id @default(uuid())
  transactionId   String   @unique // "TX-2026-0001"
  // parties
  requestId       String?  // if fulfilling a request
  assetId         String?  // if purchasing an asset
  buyerId         String   // consumer
  buyerName       String
  sellerId        String   // producer
  sellerName      String
  // value
  amount          Float
  currency        String   @default("USD")
  // attribution (links to ValueAttribution)
  attributionId   String?  // ValueAttribution.attributionId
  // status
  status          String   @default("pending") // pending | escrow | completed | refunded | disputed
  paidAt          DateTime?
  completedAt     DateTime?
  // temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

// ValueAttribution — multi-source contribution splitting.
// When intelligence is verified, the reward is split across all contributors
// based on their contribution percentage (satellite 30%, citizen 25%, etc.)
model ValueAttribution {
  id              String   @id @default(uuid())
  attributionId   String   @unique // "VAT-2026-0001"
  // context
  transactionId   String?  // IntelligenceTransaction.transactionId
  bountyId        String?  // IntelligenceBounty.bountyId (if from a bounty)
  incidentId      String?  // IncidentArtifact.incidentId (if from command center)
  citizenEventId  String?  // CitizenEvent.eventId (if from community)
  // total reward
  totalAmount     Float
  currency        String   @default("USD")
  // contribution channels (each 0..1, should sum to ~1.0)
  satelliteShare  Float    @default(0.30)
  citizenShare    Float    @default(0.25)
  witnessShare    Float    @default(0.20)
  agentShare      Float    @default(0.15)
  fieldShare      Float    @default(0.10)
  // per-recipient breakdown
  recipients      String   @default("{}") // JSON: {recipientId: {amount, role, share}}
  // provenance — what intelligence this attribution is based on
  sourceArtifacts String   @default("[]") // JSON: [artifactHash, ...]
  // temporal
  attributedAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([transactionId])
  @@index([bountyId])
  @@index([incidentId])
}

// IntelligenceBounty — active production. Org posts a problem, system decomposes
// into missions, producers submit intelligence, rewards distributed.
model IntelligenceBounty {
  id              String   @id @default(uuid())
  bountyId        String   @unique // "BNT-2026-0001"
  // sponsor
  sponsorId       String
  sponsorName     String
  sponsorType     String   // government | corporate | ngo | platform
  // the problem
  title           String
  description     String
  category        String
  geography       String
  // reward
  totalBudget     Float
  currency        String   @default("USD")
  rewardPerSubmission Float @default(0)
  maxSubmissions  Int      @default(10)
  // decomposition — system breaks the bounty into missions
  missionIds      String   @default("[]") // JSON: [missionId, ...] (links to Mission model)
  // submissions
  submissionCount Int      @default(0)
  acceptedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  // distributed
  distributedTotal Float   @default(0)
  // status
  status          String   @default("open") // open | decomposing | accepting | reviewing | completed | closed
  deadline        DateTime?
  closedAt        DateTime?
  // temporal
  postedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([sponsorType])
}

// BountySubmission — a producer's intelligence submitted toward a bounty.
model BountySubmission {
  id              String   @id @default(uuid())
  submissionId    String   @unique // "SUB-2026-0001"
  bountyId        String   // IntelligenceBounty.bountyId
  // submitter
  producerId      String
  producerType    String   // citizen | agent | organization
  producerName    String
  // the intelligence submitted
  assetId         String?  // IntelligenceAsset.assetId if published as asset
  citizenEventId  String?  // CitizenEvent.eventId if from community
  observationId   String?  // Observation.id if from EO
  // quality
  confidence      Float    @default(0.5)
  trustScore      Float    @default(0.5)
  iqs             Float    @default(0.5)
  // review
  status          String   @default("pending") // pending | under_review | accepted | rejected | rewarded
  reviewNote      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  // reward
  rewardAmount    Float    @default(0)
  attributionId   String?  // ValueAttribution.attributionId
  // temporal
  submittedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bountyId])
  @@index([producerId])
  @@index([status])
}

// MarketplaceReview — ratings and reviews for assets and producers.
model MarketplaceReview {
  id              String   @id @default(uuid())
  reviewId        String   @unique
  // what's being reviewed
  assetId         String?
  producerId      String
  // reviewer
  reviewerId      String
  reviewerName    String
  // review
  rating          Int      // 1..5
  reviewText      String?
  // temporal
  reviewedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([assetId])
  @@index([producerId])
}

// MarketplacePackage — the package manifest for the intelligence marketplace.
model MarketplacePackage {
  id              String   @id @default(uuid())
  packageId       String   @unique
  name            String
  version         String
  provides        String   @default("[]")
  requires        String   @default("[]")
  subPackages     String   @default("[]")
  active          Boolean  @default(true)
  installedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// MILESTONE 9.5 — INTELLIGENCE FINANCE & INCENTIVE PROTOCOL (Package Layer)
// Turns the marketplace from a catalog into an actual economy. Intelligence
// ownership/licensing, non-speculative Intelligence Credits, asset derivatives
// with royalty lineage, producer market scores, agents as economic actors, and
// intelligence insurance (prediction markets). The kernel is FROZEN.
// ===========================================================================

// IntelligenceLicense — ownership + licensing per asset. Like GitHub licenses.
// Defines who can use the intelligence and under what terms.
model IntelligenceLicense {
  id              String   @id @default(uuid())
  licenseId       String   @unique
  assetId         String   // IntelligenceAsset.assetId
  // ownership
  ownerId         String   // primary owner (producer)
  ownerName       String
  contributors    String   @default("[]") // JSON: [{id, role, share}] — shared ownership
  // license type
  licenseType     String   // open_intelligence | government_only | commercial | exclusive | time_limited_exclusive
  // terms
  commercialUse   Boolean  @default(true)
  governmentUse   Boolean  @default(true)
  exclusiveUntil  DateTime? // for time-limited exclusivity
  redistributionAllowed Boolean @default(false)
  attributionRequired Boolean @default(true)
  // royalty rate (for derivative assets — % of downstream value flows to owner)
  royaltyRate     Float    @default(0.05) // 5% of downstream asset value
  // status
  status          String   @default("active") // active | revoked | expired
  // temporal
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assetId])
  @@index([ownerId])
  @@index([licenseType])
}

// CreditAccount — Intelligence Credits balance per entity. Non-speculative
// accounting unit. Not transferable money — represents verified contribution
// value + deposited budget for consumers.
model CreditAccount {
  id              String   @id @default(uuid())
  accountId       String   @unique
  ownerId         String   // citizenId | agentId | orgId | sensorId
  ownerType       String   // citizen | agent | organization | sensor | platform
  ownerName       String
  // balance
  balance         Float    @default(0) // current credit balance
  totalEarned     Float    @default(0) // lifetime earnings
  totalSpent      Float    @default(0) // lifetime spending
  totalDeposited  Float    @default(0) // lifetime deposits (consumers)
  // status
  active          Boolean  @default(true)
  // temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([ownerType])
}

// CreditTransaction — every credit movement. Deposit, spend, reward, royalty.
model CreditTransaction {
  id              String   @id @default(uuid())
  transactionId   String   @unique
  // parties
  fromAccountId   String?  // CreditAccount.accountId (null = mint/platform)
  toAccountId     String?  // CreditAccount.accountId (null = burn/platform)
  fromOwnerName   String?
  toOwnerName     String?
  // amount
  amount          Float    // positive = credit movement
  // type
  type            String   // deposit | purchase | reward | royalty | refund | platform_fee
  // context
  referenceType   String?  // marketplace_transaction | bounty | attribution | lineage_royalty | insurance
  referenceId     String?  // ID of the reference
  description     String
  // temporal
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([type])
  @@index([processedAt])
}

// WithdrawalRequest — a citizen's request to withdraw Intelligence Credits as
// mobile money (MTN/Vodafone/AirtelTigo). Tracked separately from
// CreditTransaction so admin/operators can review, process, and reconcile.
model WithdrawalRequest {
  id                String   @id @default(uuid())
  requestId         String   @unique // WR-YYYY-NNNN
  userId            String   // User.id
  accountId         String   // CreditAccount.accountId
  amount            Float    // IC amount to withdraw
  mobileMoneyNumber String   // phone number for mobile money payout
  provider          String   @default("mtn") // mtn | vodafone | airteltigo
  status            String   @default("pending") // pending | processing | completed | rejected
  notes             String?
  processedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// AssetLineage — derivative tracking. An intelligence asset can spawn downstream
// assets. The lineage tracks the full chain so royalties flow to original
// contributors. Like intellectual property royalties.
model AssetLineage {
  id              String   @id @default(uuid())
  lineageId       String   @unique
  // the derivative asset
  assetId         String   // IntelligenceAsset.assetId (the downstream/derived asset)
  // parent assets this was derived from
  parentAssetIds  String   @default("[]") // JSON: [assetId, ...]
  // lineage chain (full ancestor path)
  lineageChain    String   @default("[]") // JSON: [{assetId, producerId, role, depth}]
  // derivation type
  derivationType  String   // derived_from | fused_with | enhanced_by | verified_by
  // depth (0 = original, 1 = direct derivative, 2 = derivative of derivative)
  depth           Int      @default(0)
  // temporal
  createdAt       DateTime @default(now())

  @@index([assetId])
  @@index([derivationType])
}

// RoyaltyDistribution — when a derivative asset creates value, original
// contributors receive royalties based on the lineage chain + royalty rates.
model RoyaltyDistribution {
  id              String   @id @default(uuid())
  royaltyId       String   @unique
  // the transaction that generated value
  sourceTransactionId String // CreditTransaction.transactionId
  sourceAssetId   String   // the derivative asset that was purchased/rewarded
  totalRoyaltyAmount Float // total royalty distributed
  // per-ancestor breakdown
  royaltyRecipients String @default("[]") // JSON: [{assetId, producerId, amount, royaltyRate, depth}]
  // temporal
  distributedAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([sourceAssetId])
  @@index([sourceTransactionId])
}

// ProducerMarketScore — Intelligence Market Score. Every producer gets a
// composite score: trust + civic + IQS contribution + historical value created.
// Enables professional intelligence producers.
model ProducerMarketScore {
  id              String   @id @default(uuid())
  producerId      String   @unique
  producerType    String   // citizen | agent | sensor | organization
  producerName    String
  // components (0..100)
  trustScore      Float    @default(50)
  civicScore      Float    @default(50)
  iqsContribution Float    @default(50) // avg IQS of their assets
  valueCreated    Float    @default(0) // lifetime $ value produced
  // composite
  marketScore     Float    @default(50) // 0..100
  marketRank      Int      @default(0) // rank among all producers
  marketTier      String   @default("amateur") // amateur | emerging | professional | expert | elite
  // stats
  totalAssets     Int      @default(0)
  totalSales      Int      @default(0)
  avgRating       Float    @default(0)
  // temporal
  lastUpdated     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([marketScore])
  @@index([marketTier])
  @@index([producerType])
}

// AgentRevenue — agents as economic actors. Agents earn revenue from their
// intelligence outputs. Revenue is allocated across developer, training data,
// infrastructure, platform.
model AgentRevenue {
  id              String   @id @default(uuid())
  agentId         String   @unique
  agentName       String
  // earnings
  totalRevenue    Float    @default(0) // lifetime credits earned
  monthlyRevenue  Float    @default(0) // current month
  pendingPayout   Float    @default(0) // unallocated
  // allocation split (must sum to 1.0)
  developerShare  Float    @default(0.70)
  trainingDataShare Float  @default(0.15)
  infrastructureShare Float @default(0.10)
  platformShare   Float    @default(0.05)
  // allocated totals
  developerPaid   Float    @default(0)
  trainingDataPaid Float   @default(0)
  infrastructurePaid Float  @default(0)
  platformPaid    Float    @default(0)
  // stats
  totalOutputs    Int      @default(0)
  totalConsumers  Int      @default(0)
  // temporal
  lastEarnedAt    DateTime?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// InsurancePolicy — intelligence insurance / prediction markets. An insurer
// posts a question with a payout. Producers submit predictions. Payouts based
// on accuracy once the outcome is known.
model InsurancePolicy {
  id              String   @id @default(uuid())
  policyId        String   @unique
  // insurer
  insurerId       String
  insurerName     String
  // the question
  title           String
  description     String
  category        String   // drought | flood | crop_loss | mining_activity | ...
  geography       String
  // prediction window
  predictionWindow String  // "2026-Q1" | "next_30_days"
  deadline        DateTime // when predictions close
  resolutionDate  DateTime // when outcome is known
  // payout
  totalPayout     Float    // total credits to distribute
  payoutModel     String   @default("accuracy_weighted") // accuracy_weighted | winner_takes_all | proportional
  // resolution
  outcome         String?  // confirmed | denied | partial (set at resolution)
  outcomeNotes    String?
  resolvedAt      DateTime?
  // stats
  predictionCount Int      @default(0)
  // status
  status          String   @default("open") // open | predicting | resolving | resolved | cancelled
  // temporal
  postedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([category])
}

// InsurancePrediction — a producer's prediction on an insurance question.
// Payout based on accuracy once the outcome is known.
model InsurancePrediction {
  id              String   @id @default(uuid())
  predictionId    String   @unique
  policyId        String   // InsurancePolicy.policyId
  // predictor
  predictorId     String
  predictorType   String   // citizen | agent | organization
  predictorName   String
  // the prediction
  predictedOutcome String  // confirmed | denied | partial
  confidence      Float    @default(0.5) // predictor's confidence
  reasoning       String?  // why
  // quality (at submission time)
  trustScore      Float    @default(0.5)
  // resolution
  accuracyScore   Float?   // 0..1 — computed at resolution
  payoutAmount    Float    @default(0) // credits paid
  // temporal
  submittedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([policyId, predictorId])
  @@index([policyId])
  @@index([predictorId])
}

// IntelligenceFinancePackage — package manifest.
model IntelligenceFinancePackage {
  id              String   @id @default(uuid())
  packageId       String   @unique
  name            String
  version         String
  provides        String   @default("[]")
  requires        String   @default("[]")
  subPackages     String   @default("[]")
  active          Boolean  @default(true)
  installedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// MILESTONE 10 — FEDERATED INTELLIGENCE NETWORK (Package Layer)
// Multiple intelligence civilizations interoperate without surrendering sovereignty.
// Federation protocol: discovery, trust proof exchange (not copies), asset/capability
// exchange, cross-border markets, intelligence treaties. Data stays local; only
// proofs + assets + capabilities are exchanged. The kernel is FROZEN.
// ===========================================================================

// FederationNode — a participating intelligence network (country/org).
// Each node maintains sovereignty over its data, citizens, trust graph.
model FederationNode {
  id              String   @id @default(uuid())
  nodeId          String   @unique // "ghana" | "kenya" | "nigeria" | "ci" | "ecowas"
  name            String   // "Ghana Intelligence Network"
  countryCode     String   // "GH" | "KE" | "NG" | "CI"
  nodeType        String   // national | regional | organizational
  // endpoint
  endpointUrl     String   // federation API endpoint
  // status
  status          String   @default("active") // active | degraded | offline | suspended
  lastSeenAt      DateTime?
  // federation stats
  trustScore      Float    @default(0.5) // this node's trust in the federation
  assetsShared    Int      @default(0)
  assetsConsumed  Int      @default(0)
  citizensFederated Int    @default(0)
  // treaty membership
  treatiesCount   Int      @default(0)
  // temporal
  joinedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([countryCode])
}

// FederatedIdentityProof — trust proofs exchanged between nodes. NOT copies.
// Ghana sends a proof that Kwesi is trusted. Nigeria imports an initial trust
// score but local evidence updates it. The proof is a cryptographic attestation.
model FederatedIdentityProof {
  id              String   @id @default(uuid())
  proofId         String   @unique
  // the identity being attested
  subjectId       String   // citizenId/agentId in the home network
  subjectName     String
  subjectType     String   // citizen | agent | organization
  // issuing node (home network)
  issuingNodeId   String   // "ghana"
  issuingNodeName String
  // receiving node (importing network)
  receivingNodeId String   // "nigeria"
  // the attestation
  homeTrustScore  Float    // trust score in home network
  confirmedEvents Int      // confirmed contributions
  sybilFlags      Int      // 0 = clean
  verificationLevel String // "biometric" | "national" | "phone"
  // cryptographic proof
  proofHash       String   // hash of the attestation
  proofSignature  String?  // cryptographic signature
  // imported trust (receiving node's initial trust for this identity)
  importedTrust   Float    @default(40) // starts lower than home trust
  // status
  status          String   @default("active") // active | revoked | expired
  expiresAt       DateTime?
  // temporal
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([subjectId])
  @@index([issuingNodeId])
  @@index([receivingNodeId])
}

// TrustAttestation — a node attests to the trustworthiness of another node
// or a cross-border identity. Builds the federated trust graph.
model TrustAttestation {
  id              String   @id @default(uuid())
  attestationId   String   @unique
  // attester → subject
  attesterNodeId  String
  subjectNodeId   String?  // null if attesting to a citizen/agent
  subjectId       String?  // citizenId/agentId (if non-node subject)
  // attestation
  attestationType String   // node_trust | identity_trust | capability_quality
  trustValue      Float    // 0..1
  note            String?
  // temporal
  attestedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([attesterNodeId])
  @@index([subjectNodeId])
}

// FederatedAssetListing — an asset listed for cross-border consumption.
// The asset stays in its home network; only the listing is federated.
model FederatedAssetListing {
  id              String   @id @default(uuid())
  listingId       String   @unique
  // source
  homeNodeId      String   // "ghana"
  homeAssetId     String   // IntelligenceAsset.assetId in home network
  assetTitle      String
  assetDescription String
  category        String
  producerName    String
  producerType    String
  // quality (snapshot at listing time)
  iqs             Float
  trustScore      Float
  confidence      Float
  // pricing
  price           Float
  currency        String   @default("IC")
  // licensing (federated)
  licenseType     String   // commercial_africa | open_intelligence | government_only
  transferable    Boolean  @default(true)
  // treaty compliance
  treatyCompliant Boolean  @default(true)
  // consumption stats (federated)
  crossBorderPurchases Int  @default(0)
  revenueFromFederation Float @default(0)
  // status
  status          String   @default("listed") // listed | delisted | expired
  listedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([homeNodeId])
  @@index([category])
  @@index([status])
}

// CrossBorderRequest — a request from one node for intelligence from others.
// Enables cross-border intelligence markets (e.g. ECOWAS posts a regional request).
model CrossBorderRequest {
  id              String   @id @default(uuid())
  requestId       String   @unique
  // requester
  requesterNodeId String   // "ecowas" | "ghana" | "nigeria"
  requesterName   String
  // the request
  title           String
  description     String
  category        String
  geography       String   // "west_africa" | "volta_basin" | "shared_rivers"
  // budget
  budget          Float
  currency        String   @default("IC")
  // participation
  participatingNodes String @default("[]") // JSON: [nodeId, ...]
  submissionCount Int      @default(0)
  acceptedCount   Int      @default(0)
  // distribution
  distributedTotal Float   @default(0)
  // status
  status          String   @default("open") // open | accepting | reviewing | completed | closed
  deadline        DateTime?
  // temporal
  postedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([requesterNodeId])
  @@index([category])
}

// FederationTreaty — bilateral or multilateral agreement between nodes.
// Defines what intelligence can be shared, what's restricted. Governance as a package.
model FederationTreaty {
  id              String   @id @default(uuid())
  treatyId        String   @unique // "TR-GH-CI-001"
  name            String
  description     String
  // parties
  partyNodeIds    String   @default("[]") // JSON: [nodeId, ...]
  treatyType      String   // bilateral | multilateral | regional
  // scope
  allowedCategories String  @default("[]") // JSON: [flood, climate, agriculture]
  restrictedCategories String @default("[]") // JSON: [citizen_identity, enforcement, investigations]
  // data sovereignty
  citizenIdentitiesShared Boolean @default(false)
  rawEvidenceShared Boolean @default(false)
  onlyProofsExchanged Boolean @default(true)
  // economics
  revenueSharingModel String @default("producer_60_consumer_20_federation_20")
  // status
  status          String   @default("active") // draft | active | suspended | terminated
  signedAt        DateTime?
  expiresAt       DateTime?
  // temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([treatyType])
}

// FederationSyncRun — record of a federation sync pass between nodes.
model FederationSyncRun {
  id              String   @id @default(uuid())
  runId           String   @unique
  // sync
  sourceNodeId    String
  targetNodeId    String
  syncType        String   // trust_proofs | asset_listings | treaty_updates | capability_registry
  // results
  itemsSynced     Int      @default(0)
  itemsRejected   Int      @default(0)
  // temporal
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?
  createdAt       DateTime @default(now())

  @@index([sourceNodeId])
  @@index([targetNodeId])
}

// FederationPackage — package manifest for the federation protocol.
model FederationPackage {
  id              String   @id @default(uuid())
  packageId       String   @unique
  name            String
  version         String
  provides        String   @default("[]")
  requires        String   @default("[]")
  subPackages     String   @default("[]")
  active          Boolean  @default(true)
  installedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// MILESTONE 11 — INTELLIGENCE OS MARKETPLACE & DEVELOPER ECONOMY (Package Layer)
// The capstone: anyone can build, publish, monetize, govern, and deploy
// intelligence capabilities. Package registry, developer economy, solution
// marketplace, intelligence graph, global exchange. The kernel is FROZEN.
// ===========================================================================

// DeveloperProfile — a new economic actor. Universities, NGOs, startups,
// governments publish intelligence packages. Each gets trust, revenue, impact.
model DeveloperProfile {
  id              String   @id @default(uuid())
  developerId     String   @unique // "dev-uog-ghana" | "dev-startup-mining"
  name            String   // "University of Ghana"
  developerType   String   // university | ngo | startup | government | independent | corporation
  countryCode     String?  // "GH"
  bio             String?
  // trust + reputation
  trustScore      Float    @default(50) // 0..100
  certificationLevel String @default("none") // none | verified | certified | official
  // package stats
  packagesPublished Int    @default(0)
  totalDownloads    Int    @default(0)
  totalDeployments  Int    @default(0)
  // economy
  totalRevenue     Float    @default(0) // IC earned
  monthlyRevenue   Float    @default(0)
  // quality
  avgPackageAccuracy Float  @default(0)
  avgRating        Float    @default(0)
  ratingCount      Int      @default(0)
  // impact
  impactScore      Float    @default(0) // computed from value created
  marketplaceRank  Int      @default(0)
  // temporal
  joinedAt         DateTime @default(now())
  lastActiveAt     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([developerType])
  @@index([trustScore])
  @@index([marketplaceRank])
}

// OSIntelligencePackage — a published intelligence capability in the marketplace.
// Agents, connectors, models, knowledge, policies, workflows.
model OSIntelligencePackage {
  id              String   @id @default(uuid())
  packageId       String   @unique // "illegal-mining-detector"
  name            String
  displayName     String
  description     String
  // publisher
  developerId     String   // DeveloperProfile.developerId
  developerName   String
  // classification
  packageType     String   // agent | connector | model | knowledge | policy | workflow
  category        String   // environmental | flood | mining | agriculture | climate | ...
  // capabilities
  capabilities    String   @default("[]") // JSON: [sar.analysis, optical.imagery, ...]
  requirements    String   @default("[]") // JSON: [sentinel-2, osm, ...]
  // version
  version         String   @default("1.0.0")
  latestVersionId String?  // PackageVersion.versionId
  // quality metrics
  accuracy        Float    @default(0.5)
  iqs             Float    @default(0.5) // Intelligence Quality Score
  trustScore      Float    @default(0.5)
  // economics
  pricingModel    String   @default("free") // free | usage | subscription | one_time
  pricePerUse     Float    @default(0) // IC per execution
  subscriptionPrice Float  @default(0) // IC per month
  // marketplace rank (computed)
  marketplaceRank Float    @default(0) // 0..100
  // adoption
  downloads       Int      @default(0)
  deployments     Int      @default(0)
  activeInstalls  Int      @default(0)
  // governance
  lifecycleStage  String   @default("experimental") // draft | experimental | verified | certified | official | deprecated | archived
  securityReviewed Boolean @default(false)
  conformancePassed Boolean @default(false)
  // ratings
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  // federation
  federationReady Boolean  @default(true)
  // temporal
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([packageType])
  @@index([category])
  @@index([lifecycleStage])
  @@index([marketplaceRank])
  @@index([developerId])
}

// PackageVersion — versioned releases of a package.
model PackageVersion {
  id              String   @id @default(uuid())
  versionId       String   @unique
  packageId       String   // OSIntelligencePackage.packageId
  version         String   // "2.1.0"
  // changelog
  releaseNotes    String
  // changes
  checksum        String   // content hash for integrity
  signature       String?  // cryptographic signature
  // quality at release time
  accuracySnapshot Float   @default(0.5)
  iqsSnapshot     Float    @default(0.5)
  // status
  status          String   @default("active") // active | yanked | deprecated
  // temporal
  releasedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([packageId])
  @@index([version])
}

// PackageDownload — download/install tracking.
model PackageDownload {
  id              String   @id @default(uuid())
  packageId       String
  version         String
  downloaderId    String   // org/node/citizen that downloaded
  downloaderName  String
  downloaderType  String   // organization | node | citizen
  // deployment
  deploymentId    String?  // unique deployment instance
  status          String   @default("installed") // installed | active | uninstalled
  // temporal
  downloadedAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([packageId])
  @@index([downloaderId])
}

// PackageUsageEvent — usage tracking for royalties + analytics.
model PackageUsageEvent {
  id              String   @id @default(uuid())
  eventId         String   @unique
  packageId       String
  version         String
  // consumer
  consumerId      String
  consumerName    String
  consumerType    String   // organization | node | citizen
  // usage
  usageType       String   // execution | query | deployment | api_call
  // cost
  costCharged     Float    @default(0) // IC charged
  // result
  success         Boolean  @default(true)
  // temporal
  usedAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([packageId])
  @@index([consumerId])
  @@index([usedAt])
}

// SolutionPackage — complete intelligence systems. Not capabilities — outcomes.
// "Illegal Mining Monitoring OS" = satellite + agent + citizen + trust + workflow.
model SolutionPackage {
  id              String   @id @default(uuid())
  solutionId      String   @unique // "illegal-mining-monitoring-os"
  name            String
  displayName     String
  description     String
  // publisher
  developerId     String
  developerName   String
  // composition — what packages are included
  componentPackageIds String @default("[]") // JSON: [packageId, ...]
  componentCount  Int      @default(0)
  // what it solves
  problemCategory String   // environmental_enforcement | flood_defense | forest_protection | ...
  targetOutcome   String   // "reduce illegal mining incidents"
  // economics
  pricingModel    String   @default("subscription") // subscription | one_time | custom
  price           Float    @default(0) // IC
  // adoption
  deployments     Int      @default(0)
  activeInstalls  Int      @default(0)
  // ratings
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  // status
  lifecycleStage  String   @default("verified")
  // temporal
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([problemCategory])
  @@index([lifecycleStage])
  @@index([developerId])
}

// DeveloperRevenue — revenue tracking per developer (from packages + solutions).
model DeveloperRevenue {
  id              String   @id @default(uuid())
  developerId     String   @unique
  developerName   String
  // totals
  totalRevenue    Float    @default(0)
  monthlyRevenue  Float    @default(0)
  pendingPayout   Float    @default(0)
  // allocation split
  developerShare  Float    @default(0.70)
  contributorShare Float   @default(0.20)
  platformShare   Float    @default(0.10)
  // allocated
  developerPaid   Float    @default(0)
  contributorPaid Float    @default(0)
  platformPaid    Float    @default(0)
  // by package type
  agentRevenue    Float    @default(0)
  connectorRevenue Float   @default(0)
  modelRevenue    Float    @default(0)
  knowledgeRevenue Float   @default(0)
  solutionRevenue Float    @default(0)
  // stats
  topEarningPackage String?
  // temporal
  lastEarnedAt    DateTime?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// PackageReview — ratings + reviews for packages.
model PackageReview {
  id              String   @id @default(uuid())
  reviewId        String   @unique
  packageId       String   // OSIntelligencePackage.packageId (or solutionId)
  reviewerId      String
  reviewerName    String
  reviewerType    String   // organization | node | citizen | developer
  // review
  rating          Int      // 1..5
  reviewText      String?
  // quality assessment
  accuracyRating  Int?     // 1..5
  reliabilityRating Int?   // 1..5
  valueForMoney   Int?     // 1..5
  // temporal
  reviewedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([packageId])
  @@index([reviewerId])
}

// IntelligenceGraphNode — the global intelligence graph. Every package knows
// who uses it, what problems it solves, what it consumes/produces.
model IntelligenceGraphNode {
  id              String   @id @default(uuid())
  nodeId          String   @unique
  nodeType        String   // package | solution | developer | consumer | problem | capability
  label           String
  // graph metrics
  centrality      Float    @default(0)
  impactScore     Float    @default(0)
  // metadata
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nodeType])
  @@index([impactScore])
}

// IntelligenceGraphEdge — relationships in the intelligence graph.
// package→capability (provides), package→package (depends_on),
// consumer→package (uses), package→problem (solves), package→package (composes)
model IntelligenceGraphEdge {
  id              String   @id @default(uuid())
  sourceNodeId    String
  targetNodeId    String
  edgeType        String   // provides | depends_on | uses | solves | composes | produces | consumes
  weight          Float    @default(1.0)
  createdAt       DateTime @default(now())

  @@unique([sourceNodeId, targetNodeId, edgeType])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([edgeType])
}

// OSPackage — the package manifest for the OS marketplace itself.
model OSPackage {
  id              String   @id @default(uuid())
  packageId       String   @unique
  name            String
  version         String
  provides        String   @default("[]")
  requires        String   @default("[]")
  subPackages     String   @default("[]")
  active          Boolean  @default(true)
  installedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// MILESTONE 12 — INTELLIGENCE GOVERNANCE & CONSTITUTIONAL LAYER (Package Layer)
// Who governs the intelligence civilization? Constitution (rules), Council
// (federated governance), Courts (dispute resolution), Proposals (change process).
// The kernel is FROZEN. All package-layer.
// ===========================================================================

// IntelligenceConstitution — the foundational rules of the intelligence civilization.
// Defines who can create agents, publish intelligence, override AI decisions,
// access evidence, suspend packages. Like a constitution for a nation.
model IntelligenceConstitution {
  id              String   @id @default(uuid())
  constitutionId  String   @unique // "constitution-v1"
  version         String   @default("1.0.0")
  title           String
  preamble        String   // founding principles
  status          String   @default("ratified") // draft | ratified | amended | superseded
  ratifiedAt      DateTime?
  articleCount    Int      @default(0)
  amendmentCount  Int      @default(0)
  // temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// ConstitutionArticle — individual articles of the constitution.
// Each article governs a specific aspect of intelligence civilization.
model ConstitutionArticle {
  id              String   @id @default(uuid())
  articleId       String   @unique // "ART-001"
  constitutionId  String   // IntelligenceConstitution.constitutionId
  number          Int      // article number
  title           String
  body            String   // the rule text
  category        String   // rights | obligations | procedures | limits | oversight
  // what this article governs
  governs         String   // "agent_creation" | "intelligence_publication" | "ai_override" | "evidence_access" | "package_suspension" | "citizen_rights" | "developer_rights" | "federation"
  // enforcement
  enforcementMechanism String // "automatic" | "council_review" | "court_arbitration"
  // status
  status          String   @default("active") // active | amended | repealed
  // temporal
  ratifiedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([constitutionId])
  @@index([category])
  @@index([governs])
}

// ConstitutionAmendment — amendments to the constitution.
// Changes require council approval. Full audit trail.
model ConstitutionAmendment {
  id              String   @id @default(uuid())
  amendmentId     String   @unique // "AMD-001"
  constitutionId  String
  articleId       String?  // null = new article; non-null = amending existing
  amendmentType   String   // "add" | "modify" | "repeal"
  title           String
  description     String
  proposedText    String?  // new text if add/modify
  // proposer
  proposedBy      String
  proposerName    String
  // voting
  voteCount       Int      @default(0)
  approveCount    Int      @default(0)
  rejectCount     Int      @default(0)
  // status
  status          String   @default("proposed") // proposed | under_review | approved | rejected | ratified
  ratifiedAt      DateTime?
  // temporal
  proposedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([constitutionId])
  @@index([status])
}

// GovernanceCouncil — the federated governing body. Not a central authority —
// a federation of representatives from governments, institutions, citizens,
// developers, and scientific organizations.
model GovernanceCouncil {
  id              String   @id @default(uuid())
  councilId       String   @unique // "global-intelligence-council"
  name            String
  description     String
  councilType     String   // "global" | "regional" | "national" | "domain"
  scope           String   // "planetary" | "africa" | "ghana" | "mining"
  // composition
  memberCount     Int      @default(0)
  seatCount       Int      @default(12) // total seats
  // voting rules
  quorumThreshold Float    @default(0.6) // 60% of members must vote
  approvalThreshold Float @default(0.66) // 66% of votes must approve
  // status
  status          String   @default("active")
  // temporal
  establishedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([councilType])
  @@index([status])
}

// CouncilMember — representatives on the council. Each represents a constituency.
model CouncilMember {
  id              String   @id @default(uuid())
  memberId        String   @unique
  councilId       String   // GovernanceCouncil.councilId
  // identity
  representativeName String
  representativeId String  // citizenId | developerId | orgId
  // constituency
  constituencyType String  // "government" | "citizen" | "developer" | "scientific" | "ngo" | "regional"
  constituencyName String  // "EPA Ghana" | "Citizen Representatives" | "University of Ghana"
  // voting weight (1 = equal; some constituencies may have more weight)
  votingWeight    Float    @default(1.0)
  // term
  termStart       DateTime @default(now())
  termEnd         DateTime?
  // status
  status          String   @default("active") // active | suspended | expired
  // temporal
  seatedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([councilId])
  @@index([constituencyType])
  @@index([status])
}

// CouncilVote — votes on proposals, amendments, and decisions.
model CouncilVote {
  id              String   @id @default(uuid())
  voteId          String   @unique
  councilId       String
  memberId        String   // CouncilMember.memberId
  memberName      String
  // what's being voted on
  proposalType    String   // "amendment" | "package_approval" | "court_appointment" | "budget" | "treaty" | "suspension"
  proposalId      String   // ID of the proposal/amendment/etc.
  proposalTitle   String
  // vote
  vote            String   // "approve" | "reject" | "abstain"
  rationale       String?
  votingWeight    Float    @default(1.0)
  // temporal
  votedAt         DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([proposalType, proposalId, memberId])
  @@index([proposalType, proposalId])
  @@index([memberId])
}

// IntelligenceCourt — dispute resolution. For cases like: agent caused false
// enforcement, package manipulated evidence, developer violated license,
// citizen reputation attacked unfairly.
model IntelligenceCourt {
  id              String   @id @default(uuid())
  courtId         String   @unique // "court-ghana" | "court-ecowas" | "court-global"
  name            String
  description     String
  jurisdiction    String   // "national" | "regional" | "global" | "domain"
  scope           String   // "ghana" | "africa" | "planetary" | "mining"
  // composition
  justiceCount    Int      @default(5)
  // status
  status          String   @default("active")
  establishedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([jurisdiction])
  @@index([status])
}

// CourtCase — a dispute brought before an intelligence court.
model CourtCase {
  id              String   @id @default(uuid())
  caseId          String   @unique // "CASE-2026-0001"
  courtId         String   // IntelligenceCourt.courtId
  // parties
  plaintiffId     String
  plaintiffName   String
  plaintiffType   String   // citizen | developer | organization | agent | government
  defendantId     String
  defendantName   String
  defendantType   String
  // the dispute
  caseType        String   // "false_enforcement" | "evidence_manipulation" | "license_violation" | "reputation_attack" | "attribution_dispute" | "package_misconduct" | "contract_breach"
  title           String
  description     String
  // evidence
  evidenceArtifacts String  @default("[]") // JSON: [artifactHash, ...]
  // damages claimed
  damagesClaimed  Float    @default(0) // IC
  // verdict
  verdict         String?  // "for_plaintiff" | "for_defendant" | "settled" | "dismissed"
  verdictSummary  String?
  damagesAwarded  Float    @default(0)
  // appeals
  appealedFrom    String?  // caseId if appealed from lower court
  // status
  status          String   @default("filed") // filed | under_review | hearing | ruled | appealed | closed
  filedAt         DateTime @default(now())
  ruledAt         DateTime?
  closedAt        DateTime?
  // temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([courtId])
  @@index([caseType])
  @@index([status])
}

// CourtVerdict — the formal ruling on a case. Includes reasoning + remedies.
model CourtVerdict {
  id              String   @id @default(uuid())
  verdictId       String   @unique
  caseId          String   // CourtCase.caseId
  courtId         String
  // the ruling
  ruling          String   // "for_plaintiff" | "for_defendant" | "settled" | "dismissed"
