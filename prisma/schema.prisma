// Ghana Digital Twin — World Model Foundation schema
// Spatial storage on SQLite: geometry stored as GeoJSON + dedicated bbox/centroid
// columns for indexed spatial queries. Turf provides precise geometry ops in app layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Core Entity (versioned, provenance-tracked) =====
model Entity {
  id              String   @id @default(uuid())
  uuid            String   @unique
  // stable external identifier (e.g. "geoboundaries:GHA-ADM1-ashanti", "osm:way:4790617")
  externalId      String   @unique
  kind            String   // river | lake | watershed | forest | road | settlement | ...
  type            String   // natural | infrastructure | administrative | human_activity
  name            String
  regionId        String?
  geometryType    String   // Point | LineString | Polygon | MultiPolygon
  geometryGeoJson String   // full GeoJSON geometry (WGS84)
  // spatial index columns
  centroidLng     Float
  centroidLat     Float
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  areaKm2         Float?
  lengthKm        Float?
  attributes      String   @default("{}") // JSON
  tags            String   @default("[]") // JSON array
  confidence      Float    @default(1.0)
  // provenance
  datasetSourceId String
  sourceName      String
  sourceVersion   String
  // temporal
  firstObserved   DateTime
  lastObserved    DateTime
  currentVersion  Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  datasetSource     DatasetSource  @relation(fields: [datasetSourceId], references: [id])
  versions          EntityVersion[]
  relationshipsFrom Relationship[] @relation("fromEntity")
  relationshipsTo   Relationship[] @relation("toEntity")

  @@index([kind])
  @@index([type])
  @@index([regionId])
  @@index([minLng, maxLng, minLat, maxLat])
  @@index([centroidLng, centroidLat])
}

// ===== Versioned history (nothing is overwritten) =====
model EntityVersion {
  id              String   @id @default(uuid())
  entityId        String
  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  version         Int
  change          String   // human description of what changed
  geometryGeoJson String
  attributes      String
  confidence      Float
  sourceName      String
  sourceVersion   String
  observedAt      DateTime
  createdAt       DateTime @default(now())

  @@unique([entityId, version])
  @@index([entityId, version])
  @@index([observedAt])
}

// ===== Spatial relationship graph =====
model Relationship {
  id           String   @id @default(uuid())
  fromEntityId String
  toEntityId   String
  relation     String   // contains | within | intersects | adjacent_to | tributary_of | flows_to | part_of | near
  inferredBy   String   // spatial | source | manual
  confidence   Float    @default(1.0)
  createdAt    DateTime @default(now())

  fromEntity Entity @relation("fromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   Entity @relation("toEntity", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, relation])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relation])
}

// ===== Dataset source registry (provenance + health) =====
model DatasetSource {
  id            String    @id @default(uuid())
  sourceId      String    @unique // "geoboundaries", "osm-overpass", "hydrosheds", ...
  name          String
  category      String    // administrative | hydrology | dem | landcover | weather | infrastructure | environmental | population | forest
  provider      String
  license       String
  resolution    String
  cadence       String
  coverage      String
  description   String
  storageType   String    @default("vector") // vector | raster | metadata
  status        String    @default("pending") // pending | healthy | syncing | degraded | offline
  recordCount   Int       @default(0)
  version       String?
  lastSyncAt    DateTime?
  lastSuccessAt DateTime?
  metadata      String    @default("{}") // JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entities Entity[]
  runs     ConnectorRun[]


  @@index([status])
}

// ===== Connector run history (observability) =====
model ConnectorRun {
  id             String   @id @default(uuid())
  sourceId       String
  source         DatasetSource @relation(fields: [sourceId], references: [id])
  startedAt      DateTime
  finishedAt     DateTime?
  status         String   // running | success | failed | partial
  stage          String   @default("") // current pipeline stage
  recordsRead    Int      @default(0)
  recordsWritten Int     @default(0)
  durationMs     Int      @default(0)
  error          String?
  events         String   @default("[]") // JSON array of pipeline stage events
  createdAt      DateTime @default(now())

  @@index([sourceId, startedAt])
  @@index([status])
}

// ===== Event log (powers downstream AI + observability) =====
model IngestionEvent {
  id        String   @id @default(uuid())
  type      String   // DatasetDownloaded | DatasetValidated | EntityCreated | EntityUpdated | EntityVersionCreated | RelationshipsUpdated | ConnectorFailed | ConnectorRecovered | ...
  sourceId  String?
  entityId  String?
  message   String
  level     String   @default("info") // info | warn | error
  payload   String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([type])
  @@index([sourceId])
  @@index([createdAt])
}

// ===== Earth Observation Platform (Milestone 2.5) =====

// STAC item — one satellite scene
model RasterScene {
  id              String   @id @default(uuid())
  stacId          String   @unique // e.g. "S2B_30NYM_20240701_0_L2A"
  collection      String   // "sentinel-2-l2a" | "sentinel-2-c1-l2a" | "landsat-c2-l2" | ...
  platform        String?  // "Sentinel-2B"
  instrument      String?  // "MSI"
  constellation   String?  // "sentinel-2"
  // spatial
  geometryGeoJson String   // footprint GeoJSON
  centroidLng     Float
  centroidLat     Float
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  mgrsTile        String?  // "30NYM"
  // temporal
  datetime        DateTime
  // quality
  cloudCover      Float?
  // processing
  processingLevel String?  // "L2A"
  gsd             Float?   // ground sample distance (m)
  // provenance
  sourceId        String   // dataset source id ("stac-sentinel-2")
  stacVersion     String   @default("1.0.0")
  selfHref        String?
  metadata        String   @default("{}") // JSON (extra STAC properties)
  createdAt       DateTime @default(now())

  bands         RasterBand[]
  indexLayers   SpectralIndexLayer[]

  @@index([collection, datetime])
  @@index([centroidLng, centroidLat])
  @@index([minLng, maxLng, minLat, maxLat])
  @@index([datetime])
  @@index([mgrsTile])
  @@index([cloudCover])
}

// One band of a scene (e.g. red, nir, green, blue, swir16, scl) — references real COG URL
model RasterBand {
  id           String   @id @default(uuid())
  sceneId      String
  scene        RasterScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  name         String   // "red" | "nir" | "green" | "blue" | "swir16" | "scl" | ...
  commonName   String?  // "red" | "nir" ...
  displayName  String?  // "Red (B04)"
  href         String   // real COG URL on S3 / elsewhere
  type         String?  // "image/tiff; application=geotiff; profile=cloud-optimized"
  roles        String   @default("[]") // JSON array
  gsd          Float?
  shapeW       Int?
  shapeH       Int?
  // band metadata (wavelength etc.)
  bandMetadata String   @default("{}") // JSON
  createdAt    DateTime @default(now())

  @@unique([sceneId, name])
  @@index([sceneId])
  @@index([name])
}

// Computed spectral index layer (NDVI, NDWI, NBR, EVI, BSI, MNDWI, SAVI)
// References the source scene + the index formula; values computed on demand
// from real band pixels and cached as statistics.
model SpectralIndexLayer {
  id           String   @id @default(uuid())
  sceneId      String
  scene        RasterScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  indexName    String   // "NDVI" | "NDWI" | "NBR" | "EVI" | "BSI" | "MNDWI" | "SAVI"
  formula      String   // human-readable formula
  // cached statistics (computed once from real pixels over the scene footprint)
  meanValue    Float?
  minValue     Float?
  maxValue     Float?
  stdValue     Float?
  validPixelPct Float?
  computedAt   DateTime?
  createdAt    DateTime @default(now())

  @@unique([sceneId, indexName])
  @@index([sceneId])
  @@index([indexName])
}

// Factual Earth-Observation Observation (NOT AI — just facts, no conclusions)
// e.g. "NDVI decreased from 0.62 to 0.41 at [lng,lat] between [date1] and [date2]"
model EOObservation {
  id            String   @id @default(uuid())
  type          String   // "index_change" | "scene_acquired" | "cloud_gap" | "landcover_shift"
  indexName     String?  // "NDVI" | "NDWI" | ... (if applicable)
  locationLng   Float
  locationLat   Float
  // the two scenes compared
  beforeSceneId String?
  afterSceneId  String?
  // the measured values (objective facts)
  beforeValue   Float?
  afterValue    Float?
  deltaValue    Float?
  deltaPct      Float?
  // timing
  beforeDate    DateTime?
  afterDate     DateTime
  // affected world-model entity (if located)
  entityId      String?
  // objective description (NO conclusions about legality)
  summary       String
  confidence    Float    @default(1.0)
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([indexName])
  @@index([entityId])
  @@index([afterDate])
  @@index([locationLng, locationLat])
}

// ===== Milestone 2.75: Raster Intelligence Platform =====

// Seasonal baseline: expected condition (mean + std) per MGRS tile + season + index
model SeasonalBaseline {
  id            String   @id @default(uuid())
  indexName     String   // "NDVI" | "NDWI" | "NBR" | "BSI" | "MNDWI" | "EVI" | "SAVI"
  mgrsTile      String   // "30NYM"
  season        String   // "2026-Q3" or month "04"
  // gridded baseline (flattened gridSize × gridSize arrays)
  gridSize      Int      // e.g. 50
  meanGrid      String   // JSON float[] — per-cell expected mean
  stdGrid       String   // JSON float[] — per-cell expected std
  sampleCount   Int      // number of scenes used to build baseline
  uncertainty   Float    // mean per-cell uncertainty (propagated)
  // spatial extent
  minLng        Float
  minLat        Float
  maxLng        Float
  maxLat        Float
  computedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([indexName, mgrsTile, season])
  @@index([mgrsTile, season])
  @@index([indexName])
}

// Raster intelligence product: derived gridded layer with uncertainty
model RasterProduct {
  id             String   @id @default(uuid())
  type           String   // vegetation_anomaly | water_anomaly | burn_severity | bare_soil | moisture_anomaly | temporal_variance | cloud_free_composite | change_probability
  indexName      String?  // source index (NDVI, NDWI, etc.)
  sceneId        String?  // scene this product is derived from (if applicable)
  baselineId     String?  // baseline used for comparison (if applicable)
  mgrsTile       String?  // MGRS tile this covers
  season         String?  // season label
  // gridded data
  gridSize       Int      // e.g. 50
  valueGrid      String   // JSON float[] — per-cell product value
  uncertaintyGrid String  // JSON float[] — per-cell uncertainty (±)
  // summary stats
  meanValue      Float?
  minValue       Float?
  maxValue       Float?
  stdValue       Float?
  // provenance
  formula        String   // human-readable how it was computed
  sources        String   @default("[]") // JSON array of source dataset names
  confidence     Float    @default(1.0)
  // spatial extent
  minLng         Float
  minLat         Float
  maxLng         Float
  maxLat         Float
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([type])
  @@index([mgrsTile])
  @@index([sceneId])
  @@index([indexName])
}

// ===== Milestone 3: Observation Engine =====
// Observations are first-class, immutable, versioned objects. Each is produced
// by EVIDENCE FUSION across multiple raster products — never a single source.
// Observations describe objective physical-world change. No legal conclusions.

model Observation {
  id              String   @id @default(uuid())
  uuid            String   @unique
  type            String   // surface_disturbance | water_body_change | vegetation_loss | burn_event | moisture_stress
  title           String
  summary         String   // objective description, no legal conclusions
  // spatial
  geometryGeoJson String   // polygon or point
  centroidLng     Float
  centroidLat     Float
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  areaHa          Float    // affected area in hectares
  // temporal
  observedAt      DateTime
  firstObserved   DateTime
  lastUpdated     DateTime
  durationDays    Float?   // how long the change has persisted
  // assessment (fused)
  confidence      Float    // 0..1, fused from all evidence
  uncertainty     Float    // ± propagated uncertainty
  status          String   @default("active") // candidate | active | monitoring | resolved
  severity        String   @default("moderate") // low | moderate | high | critical
  // versioning (immutable — new version on evidence change)
  currentVersion  Int      @default(1)
  // provenance
  sourceProducts  String   @default("[]") // JSON: product IDs that contributed evidence
  sourceModels    String   @default("[]") // JSON: model versions used
  mgrsTile        String?
  sceneId         String?  // primary scene
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence        ObservationEvidence[]
  versions        ObservationVersion[]
  affectedEntities ObservationEntityLink[]
  evidenceLinks   ObservationEvidenceLink[]
  phenomena       PhenomenonObservation[]
  bundles         EvidenceBundle[]
  hypotheses      Hypothesis[]
  scenarios       Scenario[]

  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([centroidLng, centroidLat])
  @@index([minLng, maxLng, minLat, maxLat])
  @@index([observedAt])
  @@index([mgrsTile])
}

// Per-evidence breakdown — each raster product that contributed to the fused observation
model ObservationEvidence {
  id              String   @id @default(uuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  productType     String   // vegetation_anomaly | water_anomaly | bare_soil | change_probability | ...
  productId       String?  // FK to RasterProduct
  indexName       String?  // source spectral index
  value           Float    // the product value at this location
  normalizedSignal Float   // 0..1 normalized contribution
  weight          Float    // fusion weight
  confidence      Float    // per-evidence confidence
  uncertainty     Float    // per-evidence uncertainty
  contribution    Float    // actual contribution to fused signal (weight × signal)
  description     String   // human-readable evidence description
  createdAt       DateTime @default(now())

  @@index([observationId])
  @@index([productType])
}

// Immutable version history — nothing is overwritten
model ObservationVersion {
  id              String   @id @default(uuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  version         Int
  change          String   // what changed in this version
  confidence      Float
  uncertainty     Float
  status          String
  evidenceCount   Int
  observedAt      DateTime
  createdAt       DateTime @default(now())

  @@unique([observationId, version])
  @@index([observationId, version])
}

// Link observations to affected world-model entities (rivers, forests, settlements...)
model ObservationEntityLink {
  id              String   @id @default(uuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  entityId        String   // FK to Entity
  relationship    String   // overlaps | adjacent_to | within | upstream | downstream
  distance        Float?   // distance in km (if not overlapping)
  createdAt       DateTime @default(now())

  @@unique([observationId, entityId])
  @@index([observationId])
  @@index([entityId])
}

// ===== Milestone 3.5: Temporal Intelligence Engine =====
// Evidence as first-class immutable objects (reusable across observations),
// evolving Phenomena (temporal merging), Observation Lineage, and an
// Environmental Knowledge Graph (domain concepts separate from World Model).

// ---- Standalone Evidence (immutable, reusable) ----
// Evidence can support multiple observations. Not embedded in observations.
model Evidence {
  id              String   @id @default(uuid())
  uuid            String   @unique
  // what kind of evidence
  productType     String   // vegetation_anomaly | water_anomaly | bare_soil | change_probability | ...
  indexName       String?  // NDVI | NDWI | NBR | ...
  // the source raster product (lineage link)
  productId       String?  // FK to RasterProduct
  // spatial
  geometryGeoJson String   // point or polygon where evidence was measured
  centroidLng     Float
  centroidLat     Float
  // temporal
  observedAt      DateTime // when the source scene was captured
  // measurement
  value           Float    // the product value at this location
  normalizedSignal Float   // 0..1 normalized anomaly signal
  confidence      Float    // per-evidence confidence
  uncertainty     Float    // per-evidence uncertainty (±)
  direction       String   @default("neutral") // loss | gain | neutral
  description     String   // human-readable
  // supporting lineage (drill-down chain)
  supportingPixels Int     @default(0) // how many pixels contributed
  supportingSceneId String? // FK to RasterScene
  supportingBandHrefs String @default("[]") // JSON: COG band URLs used
  createdAt       DateTime @default(now())

  observationLinks ObservationEvidenceLink[]

  @@index([productType])
  @@index([centroidLng, centroidLat])
  @@index([observedAt])
  @@index([productId])
}

// Many-to-many: observations reference standalone evidence objects
model ObservationEvidenceLink {
  id              String   @id @default(uuid())
  observationId   String
  evidenceId      String
  weight          Float    // fusion weight of this evidence for this observation
  contribution    Float    // actual contribution (weight × signal)
  createdAt       DateTime @default(now())

  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  evidence        Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([observationId, evidenceId])
  @@index([observationId])
  @@index([evidenceId])
}

// ---- Phenomenon: evolving event tracked over time ----
model Phenomenon {
  id              String   @id @default(uuid())
  uuid            String   @unique
  type            String   // surface_disturbance | water_body_change | vegetation_loss | ...
  title           String
  summary         String
  // lifecycle
  status          String   @default("active") // emerging | active | growing | stabilizing | declining | resolved
  // spatial (current extent — may evolve)
  centroidLng     Float
  centroidLat     Float
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  currentAreaHa   Float
  // temporal
  firstObserved   DateTime
  lastObserved    DateTime
  durationDays    Float
  observationCount Int     @default(0)
  // evolution metrics
  growthRateHaPerWeek Float? // area growth rate
  growthPct       Float?   // percentage growth from first observation
  movementKm      Float?   // centroid movement from first to last
  persistenceScore Float?  // 0..1 how persistently detected
  // assessment (fused across all linked observations)
  confidence      Float    @default(0.5)
  uncertainty     Float    @default(0.2)
  severity        String   @default("moderate")
  // MGRS tile
  mgrsTile        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  observations    PhenomenonObservation[]

  @@index([type])
  @@index([status])
  @@index([centroidLng, centroidLat])
  @@index([firstObserved])
}

// Link observations to the phenomenon they belong to
model PhenomenonObservation {
  id              String   @id @default(uuid())
  phenomenonId    String
  observationId   String
  // temporal ordering
  sequence        Int      // 1 = first observation, 2 = next, etc.
  // change from previous observation in the phenomenon
  areaDeltaHa     Float?   // area change from previous
  areaDeltaPct    Float?
  centroidShiftKm Float?   // centroid movement from previous
  signalDelta     Float?   // fused signal change
  linkedAt        DateTime @default(now())

  phenomenon      Phenomenon @relation(fields: [phenomenonId], references: [id], onDelete: Cascade)
  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([phenomenonId, observationId])
  @@index([phenomenonId])
  @@index([observationId])
}

// ---- Environmental Knowledge Graph (domain concepts) ----
// Separate from World Model. Connects environmental concepts with typed relationships.
model KnowledgeNode {
  id              String   @id @default(uuid())
  conceptId       String   @unique // "vegetation_loss" | "bare_soil" | "water_turbidity" | ...
  label           String
  category        String   // cause | effect | indicator | entity_type | condition
  description     String
  color           String   @default("#a1a1aa")
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  edgesFrom       KnowledgeEdge[] @relation("fromNode")
  edgesTo         KnowledgeEdge[] @relation("toNode")

  @@index([category])
}

model KnowledgeEdge {
  id              String   @id @default(uuid())
  fromNodeId      String
  toNodeId        String
  relation        String   // precedes | causes | indicates | affects | correlates_with | often_follows
  confidence      Float    @default(0.8) // domain knowledge confidence
  description     String
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  fromNode        KnowledgeNode @relation("fromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          KnowledgeNode @relation("toNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, relation])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([relation])
}

// ===== Milestone 4: Intelligence Engine =====
// Ranked competing hypotheses with Bayesian confidence, supporting +
// contradicting evidence, deterministic rules, decision traces, and
// scenario forecasting. NOT "AI deciding legality" — principled reasoning.

// ---- Evidence Bundle: groups evidence by category per observation ----
model EvidenceBundle {
  id              String   @id @default(uuid())
  observationId   String
  category        String   // vegetation | hydrology | infrastructure | terrain | atmospheric
  label           String   // "Vegetation Evidence" etc.
  evidenceCount   Int      @default(0)
  // aggregate metrics
  meanSignal      Float    @default(0)
  meanConfidence  Float    @default(0)
  fusedUncertainty Float   @default(0)
  // summary of what this bundle indicates
  indication      String   // "vegetation loss" | "bare soil increase" | "water change"
  // the evidence IDs in this bundle (JSON array)
  evidenceIds     String   @default("[]")
  createdAt       DateTime @default(now())

  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, category])
  @@index([observationId])
  @@index([category])
}

// ---- Hypothesis: ranked competing explanation for an observation ----
model Hypothesis {
  id              String   @id @default(uuid())
  uuid            String   @unique
  observationId   String
  // the hypothesis
  type            String   // "artisanal_mining" | "road_construction" | "flood_erosion" | "agricultural_expansion" | "quarrying" | "deforestation" | "natural_clearing"
  label           String   // "Possible artisanal mining activity"
  description     String   // human-readable explanation
  // Bayesian confidence
  prior           Float    // prior probability (from base rates / rules)
  posterior       Float    // posterior probability after evidence (0..1)
  confidence      Float    // final confidence = posterior normalized across competing hypotheses
  // ranking
  rank            Int      // 1 = most likely
  isPrimary       Boolean  @default(false) // top hypothesis
  // evidence counts
  supportingCount Int      @default(0)
  contradictingCount Int   @default(0)
  missingCount    Int      @default(0)
  // reasoning
  reasoning       String   // human-readable chain of reasoning
  recommendedVerification String // "Verify with high-resolution imagery" etc.
  status          String   @default("candidate") // candidate | confirmed | rejected | superseded
  // provenance
  rulesFired      String   @default("[]") // JSON: rule IDs that contributed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  observation     Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  evidence        HypothesisEvidence[]

  @@index([observationId])
  @@index([type])
  @@index([rank])
}

// Per-evidence contribution to a hypothesis: supports / contradicts / neutral
model HypothesisEvidence {
  id              String   @id @default(uuid())
  hypothesisId    String
  evidenceId      String?  // FK to Evidence (if standalone evidence)
  bundleId        String?  // FK to EvidenceBundle (if bundle-level)
  // relationship to the hypothesis
  relationship    String   // supports | contradicts | neutral
  // Bayesian contribution
  likelihoodRatio Float    // P(evidence|hypothesis) / P(evidence|¬hypothesis)
  posteriorContribution Float // log-odds contribution
  // explanation
  description     String   // why this evidence supports/contradicts
  weight          Float    // importance weight
  createdAt       DateTime @default(now())

  hypothesis      Hypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)

  @@index([hypothesisId])
  @@index([relationship])
}

// ---- Rules Engine: deterministic rules ----
model Rule {
  id              String   @id @default(uuid())
  ruleId          String   @unique // "rule-mining-01"
  name            String
  description     String
  // condition (JSON: evidence pattern to match)
  conditions      String   // JSON: [{bundle, indication, minSignal}]
  // effect: which hypothesis to boost/suppress
  hypothesisType  String   // "artisanal_mining"
  effect          String   // "boost" | "suppress"
  // Bayesian parameters
  likelihoodRatio Float    // how much to update
  priorAdjustment Float    @default(0) // adjustment to prior
  // metadata
  category        String   // "mining" | "infrastructure" | "natural" | "agriculture"
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([hypothesisType])
  @@index([category])
}

// ---- Scenario: predictive forecast ----
model Scenario {
  id              String   @id @default(uuid())
  uuid            String   @unique
  phenomenonId    String?  // linked phenomenon (if applicable)
  observationId   String?  // or linked observation
  hypothesisId    String?  // linked hypothesis
  // forecast
  type            String   // "trend_continuation" | "seasonal" | "intervention"
  label           String
  description     String
  // temporal
  forecastDays    Int      // 30, 60, 90
  // predicted state
  predictedAreaHa Float
  predictedGrowthPct Float
  // predicted impact
  affectedRiversCount Int   @default(0)
  affectedCommunitiesCount Int @default(0)
  expectedSedimentIncrease Float? // % expected sediment increase downstream
  // confidence
  confidence      Float    @default(0.5)
  uncertainty     Float    @default(0.2)
  // assumptions
  assumptions     String   @default("[]") // JSON array of assumption strings
  createdAt       DateTime @default(now())

  observation     Observation? @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([phenomenonId])
  @@index([observationId])
}

// ===== Milestone 5: Continuous Learning & Active Intelligence =====

// Spatial grid partition of Ghana — each tile is a fixed processing unit
model ProcessingTile {
  id              String   @id @default(uuid())
  tileId          String   @unique // "gh-grid-30NYM" or "gh-cell-001"
  // spatial extent
  minLng          Float
  minLat          Float
  maxLng          Float
  maxLat          Float
  centroidLng     Float
  centroidLat     Float
  // grid coordinates
  gridRow         Int
  gridCol         Int
  // coverage
  mgrsTile        String?  // overlapping MGRS tile
  regionId        String?  // Ghana region
  // processing state
  lastProcessedAt DateTime?
  lastSceneId     String?  // last scene processed
  processingCount Int      @default(0)
  observationCount Int     @default(0)
  status          String   @default("pending") // pending | processing | processed | stale
  // last detected change
  lastChangeAt    DateTime?
  lastChangeType  String?  // observation type
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([mgrsTile])
  @@index([gridRow, gridCol])
}

// Feedback: confirmed/rejected outcomes from humans, government, community, ground truth
model FeedbackRecord {
  id              String   @id @default(uuid())
  observationId   String?
  hypothesisId    String?
  phenomenonId    String?
  // feedback
  outcome         String   // confirmed | rejected | needs_monitoring | partial
  feedbackType    String   // human_inspector | government | community | ground_truth | auto_validation
  // the confirmed/rejected hypothesis type (if applicable)
  hypothesisType  String?  // "artisanal_mining" etc.
  // reasoning
  notes           String?
  evidence        String   @default("{}") // JSON: supporting photos, reports, etc.
  // feedback provider
  providerId      String?  // user/org id
  providerRole    String?  // "inspector" | "official" | "community_member"
  credibility     Float    @default(0.8) // provider credibility score
  createdAt       DateTime @default(now())

  @@index([observationId])
  @@index([hypothesisId])
  @@index([outcome])
  @@index([feedbackType])
}

// Learning update: logged changes to priors, weights, thresholds from feedback
model LearningUpdate {
  id              String   @id @default(uuid())
  // what was updated
  updateType      String   // "prior" | "evidence_weight" | "threshold" | "rule_likelihood"
  targetId        String   // hypothesis type or rule id
  // old → new values
  oldValue        Float
  newValue        Float
  deltaPct        Float
  // why (which feedback triggered it)
  feedbackCount   Int      // number of feedback records used
  feedbackIds     String   @default("[]") // JSON
  // learning metrics
  accuracyBefore  Float?   // accuracy on feedback set before update
  accuracyAfter   Float?   // accuracy after update
  createdAt       DateTime @default(now())

  @@index([updateType])
  @@index([targetId])
}

// Continuous pipeline run log
model ProcessingRun {
  id              String   @id @default(uuid())
  startedAt       DateTime
  finishedAt      DateTime?
  status          String   @default("running") // running | success | partial | failed
  tilesProcessed  Int      @default(0)
  tilesTotal      Int      @default(0)
  scenesProcessed Int      @default(0)
  observationsCreated Int  @default(0)
  observationsUpdated Int  @default(0)
  hypothesesCreated Int    @default(0)
  phenomenaCreated Int     @default(0)
  durationMs      Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([startedAt])
}

// Learned priors (dynamic — updated by the learning engine)
model LearnedPrior {
  id              String   @id @default(uuid())
  hypothesisType  String   @unique
  originalPrior   Float    // base-rate prior from HYPOTHESIS_DEFS
  learnedPrior    Float    // current learned prior
  // accuracy metrics
  confirmations   Int      @default(0) // times this hypothesis was confirmed
  rejections      Int      @default(0) // times rejected
  falsePositives  Int      @default(0)
  falseNegatives  Int      @default(0)
  accuracy        Float    @default(0.5) // running accuracy
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([hypothesisType])
}
